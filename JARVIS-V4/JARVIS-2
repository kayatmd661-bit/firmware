  html += htmlEscape(config.mqttUser);
  html += F("'>");

  html += F("<label>MQTT Password</label><input type='password' name='password' value='");
  html += htmlEscape(config.mqttPassword);
  html += F("'>");

  html += F("<label>Device Name</label><input name='device' value='");
  html += htmlEscape(config.deviceName);
  html += F("' required>");

  html += F(
    "<br><br><button type='submit'>SAVE SETTINGS</button>"
    "</form><br><a href='/'>Back to Dashboard</a></div></body></html>"
  );

  return html;
}

// ================================================================
// RESTART SERVICE
// ================================================================

void scheduleRestart() {
  restartPending = true;
  restartAt = millis();
}

void serviceScheduledRestart() {
  if (restartPending &&
      elapsed(millis(), restartAt, RESTART_DELAY)) {
    restartPending = false;
    Serial.println("[SYSTEM] Restarting ESP32...");
    ESP.restart();
  }
}

// ================================================================
// DASHBOARD HANDLERS
// ================================================================

void handleRoot() {
  server.send(200, "text/html; charset=utf-8", dashboardHTML());
}

void handleSettings() {
  server.send(200, "text/html; charset=utf-8", settingsHTML());
}

void handleSaveSettings() {
  String host = server.arg("host");
  String portString = server.arg("port");
  String user = server.arg("user");
  String password = server.arg("password");
  String device = server.arg("device");

  host.trim();
  portString.trim();
  user.trim();
  device.trim();

  uint16_t port = 0;

  if (host.length() == 0 ||
      host.length() >= sizeof(mqttHostBuffer) ||
      user.length() >= sizeof(mqttUserBuffer) ||
      password.length() >= sizeof(mqttPasswordBuffer) ||
      device.length() == 0 ||
      device.length() >= sizeof(deviceNameBuffer) ||
      !isValidMQTTPort(portString, port)) {
    server.send(400, "text/plain; charset=utf-8",
                "Invalid settings. Check host, port and field lengths.");
    return;
  }

  DeviceConfig updatedConfig;
  updatedConfig.mqttHost = host;
  updatedConfig.mqttPort = port;
  updatedConfig.mqttUser = user;
  updatedConfig.mqttPassword = password;
  updatedConfig.deviceName = device;

  if (!saveConfiguration(updatedConfig)) {
    server.send(500, "text/plain", "Settings save failed");
    return;
  }

  config = updatedConfig;
  copyConfigToBuffers();

  mqttClient.disconnect();
  mqttConnected = false;
  discoveryPublished = false;
  configureMQTT();

  Serial.println("[WEB] MQTT settings saved");

  server.send(
    200, "text/html; charset=utf-8",
    "<html><body style='font-family:Arial;padding:20px;background:#101820;color:#fff'><h3>Settings saved successfully.</h3><a style='color:#00d4ff' href='/'>Return to Dashboard</a></body></html>"
  );
}

void handleGateOpen() {
  beginGateOpen();
  server.send(200, "text/plain", "OPEN accepted");
}

void handleGateClose() {
  beginGateClose();
  server.send(200, "text/plain", "CLOSE accepted");
}

void handleGateStop() {
  stopGateOperation();
  server.send(200, "text/plain", "STOP accepted");
}

void handleLockRoute(uint8_t index, bool locked) {
  if (index >= 4) {
    server.send(404, "text/plain", "Unknown lock");
    return;
  }

  if (!setLockOutput(index, locked)) {
    server.send(
      409, "text/plain",
      "Command rejected: main gate Close Limit is not active"
    );
    return;
  }

  server.send(
    200, "text/plain",
    locked ? "LOCK accepted" : "UNLOCK accepted"
  );
}

void handleLockMain() { handleLockRoute(0, true); }
void handleUnlockMain() { handleLockRoute(0, false); }
void handleLockBD1() { handleLockRoute(1, true); }
void handleUnlockBD1() { handleLockRoute(1, false); }
void handleLockBalcony() { handleLockRoute(2, true); }
void handleUnlockBalcony() { handleLockRoute(2, false); }
void handleLockBD2() { handleLockRoute(3, true); }
void handleUnlockBD2() { handleLockRoute(3, false); }

void handleStartWiFiSetup() {
  server.send(
    200, "text/html; charset=utf-8",
    "<html><body style='font-family:Arial;padding:20px;background:#101820;color:#fff'><h3 style='color:#00d4ff'>WiFi setup portal starting</h3>"
    "<p>Connect to <b>JARVIS-V4-SETUP</b>.</p>"
    "<p>Open <b>http://192.168.4.1</b></p></body></html>"
  );

  wifiPortalStartRequested = true;
}

void handleResetWiFi() {
  server.send(
    200, "text/plain",
    "WiFi credentials will be cleared. Restarting."
  );

  Serial.println("[WEB] WiFi reset requested");
  factoryResetTriggered = true;
}

void configureWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/settings", HTTP_GET, handleSettings);
  server.on("/save-settings", HTTP_POST, handleSaveSettings);

  server.on("/gate/open", HTTP_GET, handleGateOpen);
  server.on("/gate/close", HTTP_GET, handleGateClose);
  server.on("/gate/stop", HTTP_GET, handleGateStop);

  server.on("/lock/mainlock/lock", HTTP_GET, handleLockMain);
  server.on("/lock/mainlock/unlock", HTTP_GET, handleUnlockMain);

  server.on("/lock/bd1/lock", HTTP_GET, handleLockBD1);
  server.on("/lock/bd1/unlock", HTTP_GET, handleUnlockBD1);

  server.on("/lock/blc/lock", HTTP_GET, handleLockBalcony);
  server.on("/lock/blc/unlock", HTTP_GET, handleUnlockBalcony);

  server.on("/lock/bd2/lock", HTTP_GET, handleLockBD2);
  server.on("/lock/bd2/unlock", HTTP_GET, handleUnlockBD2);

  server.on("/start-wifi-setup", HTTP_GET, handleStartWiFiSetup);
  server.on("/reset-wifi", HTTP_GET, handleResetWiFi);

  server.onNotFound([]() {
    server.send(404, "text/plain", "Not Found");
  });

  Serial.println("[WEB] Dashboard routes configured");
}

// ================================================================
// FACTORY RESET
// ================================================================

void factoryResetAllSettings() {
  Serial.println();
  Serial.println("========================================");
  Serial.println("[RESET] FACTORY RESET STARTED");
  Serial.println("========================================");

  stopGateMotor();
  cancelGateTimers();

  mqttClient.disconnect();
  mqttConnected = false;

  stopDashboardServer();
  stopWiFiPortal();

  bool configCleared = clearPreferencesNamespace("jarvis_config");
  bool locksCleared = clearPreferencesNamespace("jarvis_v4_final");
  bool wifiEraseOK = eraseWiFiCredentials();

  config.mqttHost = MQTT_DEFAULT_HOST;
  config.mqttPort = MQTT_DEFAULT_PORT;
  config.mqttUser = MQTT_DEFAULT_USER;
  config.mqttPassword = "";
  config.deviceName = DEVICE_NAME;
  copyConfigToBuffers();

  lockStates[0] = true;
  lockStates[1] = true;
  lockStates[2] = true;
  lockStates[3] = true;

  applySavedLockStates();

  gateState = GATE_IDLE;
  gateFaultMessage = "";

  wifiHasSavedCredentials = false;
  wifiConnectionStarted = false;
  wifiConnectStartedAt = 0;
  wifiFallbackTriggered = false;
  wifiWasConnected = false;
  wifiPortalStartRequested = false;
  pendingCredentialsValid = false;
  pendingWiFiSSID = "";
  pendingWiFiPassword = "";
  savedWiFiSSID = "";
  savedWiFiPassword = "";
  mdnsStarted = false;

  if (preferences.begin("jarvis_meta", false)) {
    size_t written = preferences.putUShort("schema", FIRMWARE_CONFIG_SCHEMA);
    preferences.end();

    if (written == 0)
      Serial.println("[RESET] Schema marker save failed");
  } else {
    Serial.println("[RESET] Cannot preserve schema marker");
  }

  Serial.println(configCleared
    ? "[RESET] Configuration cleared"
    : "[RESET] Configuration clear failed");

  Serial.println(locksCleared
    ? "[RESET] Lock states cleared"
    : "[RESET] Lock-state clear failed");

  Serial.println(wifiEraseOK
    ? "[RESET] WiFi credentials erased"
    : "[RESET] WiFi erase returned an error");

  Serial.println("[RESET] Restarting into setup mode...");
  Serial.println("========================================");

  factoryResetTriggered = false;
  scheduleRestart();
}

void serviceBootButtonFactoryReset() {
  uint32_t now = millis();
  bool rawPressed = digitalRead(PIN_FACTORY_RESET) == LOW;

  if (rawPressed != factoryResetRawState) {
    factoryResetRawState = rawPressed;
    factoryResetRawChangedAt = now;
  }

  if (!elapsed(now, factoryResetRawChangedAt, FACTORY_RESET_DEBOUNCE_TIME)) {
    return;
  }

  if (factoryResetRawState && !factoryResetButtonPressed) {
    factoryResetButtonPressed = true;
    factoryResetPressAt = now;
    Serial.println("[RESET] BOOT button pressed");
  }

  if (!factoryResetRawState && factoryResetButtonPressed) {
    factoryResetButtonPressed = false;
    factoryResetPressAt = 0;
    Serial.println("[RESET] BOOT button released");
  }

  if (factoryResetButtonPressed &&
      !factoryResetTriggered &&
      elapsed(now, factoryResetPressAt, FACTORY_RESET_HOLD_TIME)) {
    factoryResetTriggered = true;
    Serial.println("[RESET] BOOT held for five seconds");
  }
}

// ================================================================
// GPIO INITIALIZATION
// ================================================================

void initializeGPIO() {
  pinMode(PIN_GATE_FWD, OUTPUT);
  pinMode(PIN_GATE_REV, OUTPUT);
  digitalWrite(PIN_GATE_FWD, LOW);
  digitalWrite(PIN_GATE_REV, LOW);

  for (uint8_t i = 0; i < 4; i++) {
    pinMode(lockPins[i], OUTPUT);
    digitalWrite(lockPins[i], HIGH);
  }

  pinMode(PIN_BUTTON_GATE, INPUT_PULLUP);
  pinMode(PIN_BUTTON_BD1, INPUT_PULLUP);
  pinMode(PIN_BUTTON_BALCONY, INPUT_PULLUP);
  pinMode(PIN_BUTTON_BD2, INPUT_PULLUP);

  pinMode(PIN_OPTO_MAIN, INPUT);
  pinMode(PIN_OPTO_BD1, INPUT);
  pinMode(PIN_OPTO_BALCONY, INPUT);
  pinMode(PIN_OPTO_BD2, INPUT);

  pinMode(PIN_BELL_MAIN, INPUT_PULLUP);
  pinMode(PIN_BELL_BD1, INPUT_PULLUP);
  pinMode(PIN_BELL_BALCONY, INPUT_PULLUP);
  pinMode(PIN_BELL_BD2, INPUT_PULLUP);

  pinMode(PIN_LIMIT_OPEN, INPUT_PULLUP);
  pinMode(PIN_LIMIT_CLOSE, INPUT_PULLUP);

  pinMode(PIN_WIFI_LED, OUTPUT);
  setStatusLed(false);

  pinMode(PIN_FACTORY_RESET, INPUT_PULLUP);

  uint32_t now = millis();

  for (uint8_t i = 0; i < 4; i++) {
    bool buttonActive = digitalRead(localButtons[i].pin) == LOW;
    localButtons[i].lastRawState = buttonActive;
    localButtons[i].stableState = false;
    localButtons[i].changedAt = now;

    bool optoActive = digitalRead(statusOptos[i].pin) == LOW;
    statusOptos[i].lastRawState = optoActive;
    statusOptos[i].stableState = optoActive;
    statusOptos[i].changedAt = now;

    bool bellActive = digitalRead(bellOptos[i].pin) == LOW;
    bellOptos[i].lastRawState = bellActive;
    bellOptos[i].stableState = false;
    bellOptos[i].changedAt = now;
  }

  factoryResetRawState = digitalRead(PIN_FACTORY_RESET) == LOW;
  factoryResetRawChangedAt = now;

  wifiLedState = false;
  wifiLedChangedAt = now;
}

// ================================================================
// SETUP
// ================================================================

void setup() {
  Serial.begin(115200);

  Serial.println();
  Serial.println("========================================");
  Serial.println("       JARVIS V4 BOOTING");
  Serial.println("========================================");

  // Local hardware initialized first.
  initializeGPIO();

  // Initialize WiFi driver before schema/NVS migration.
  initializeWiFiDriver();

  WiFi.onEvent(onWiFiEvent);
  Serial.println("[SYSTEM] WiFi event handler registered");

  checkFirmwareConfigurationSchema();

  loadConfiguration();
  copyConfigToBuffers();

  loadLockStates();

  gateOpenLimit = isGateOpenLimitActive();
  gateCloseLimit = isGateCloseLimitActive();

  applySavedLockStates();

  mqttBaseTopic = String(DEVICE_ID);
  mqttAvailabilityTopic = mqttBaseTopic + "/availability";

  configureMQTT();
  configureWiFiManager();

  configureWebServer();
  configurePortalServer();

  startInitialWiFiConnection();

  lastWiFiAttempt = millis();
  lastMQTTAttempt = millis();

  if (!wifiPortalStarted && WiFi.status() == WL_CONNECTED)
    startDashboardServer();

  Serial.println("----------------------------------------");
  Serial.println("[SYSTEM] JARVIS V4 initialized");
  Serial.println("[SYSTEM] Dashboard: HTTP 80");
  Serial.println("[SYSTEM] WiFi portal: JARVIS-V4-SETUP");
  Serial.println("[SYSTEM] Portal IP: 192.168.4.1");
  Serial.println("[SYSTEM] Captive DNS and routes enabled");
  Serial.println("[SYSTEM] mDNS: jarvis-v4.local");
  Serial.println("[SYSTEM] BOOT hold: 5 seconds");
  Serial.println("[SYSTEM] Local hardware processing enabled");
  Serial.println("----------------------------------------");
}

// ================================================================
// MAIN LOOP
// ================================================================

void loop() {
  serviceBootButtonFactoryReset();

  if (factoryResetTriggered)
    factoryResetAllSettings();

  // Local hardware processing always executes before networking.
  serviceLocalButtons();
  serviceStatusOptocouplers();
  serviceCallingBells();
  serviceGateStateMachine();

  if (dashboardServerStarted && !wifiPortalStarted)
    server.handleClient();

  serviceWiFi();
  serviceWiFiStatusLED();
  serviceMQTT();
  serviceScheduledRestart();

  yield();
}
