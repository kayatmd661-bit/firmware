bool elapsed(uint32_t now, uint32_t since, uint32_t duration) {
  return (uint32_t)(now - since) >= duration;
}

String htmlEscape(const String &input) {
  String output;
  output.reserve(input.length() + 16);

  for (size_t i = 0; i < input.length(); i++) {
    switch (input[i]) {
      case '&':  output += "&amp;"; break;
      case '<':  output += "&lt;"; break;
      case '>':  output += "&gt;"; break;
      case '"':  output += "&quot;"; break;
      case '\'': output += "&#39;"; break;
      default: output += input[i]; break;
    }
  }

  return output;
}

String jsonEscape(const String &input) {
  String output;
  output.reserve(input.length() + 16);

  for (size_t i = 0; i < input.length(); i++) {
    char c = input[i];

    switch (c) {
      case '"':  output += "\\\""; break;
      case '\\': output += "\\\\"; break;
      case '\b': output += "\\b"; break;
      case '\f': output += "\\f"; break;
      case '\n': output += "\\n"; break;
      case '\r': output += "\\r"; break;
      case '\t': output += "\\t"; break;
      default:
        if ((uint8_t)c < 0x20) output += ' ';
        else output += c;
        break;
    }
  }

  return output;
}

bool isValidMQTTPort(const String &value, uint16_t &result) {
  if (value.length() == 0 || value.length() > 5) return false;

  for (size_t i = 0; i < value.length(); i++) {
    if (!isdigit((unsigned char)value[i])) return false;
  }

  unsigned long port = value.toInt();
  if (port < 1 || port > 65535) return false;

  result = (uint16_t)port;
  return true;
}

bool isValidWiFiPassword(const String &password) {
  if (password.length() == 0) return true;

  if (password.length() >= 8 && password.length() <= 63)
    return true;

  if (password.length() == 64) {
    for (size_t i = 0; i < password.length(); i++) {
      if (!isxdigit((unsigned char)password[i])) return false;
    }
    return true;
  }

  return false;
}

