void copyConfigToBuffers() {
  strlcpy(mqttHostBuffer, config.mqttHost.c_str(), sizeof(mqttHostBuffer));
  snprintf(mqttPortBuffer, sizeof(mqttPortBuffer), "%u", config.mqttPort);
  strlcpy(mqttUserBuffer, config.mqttUser.c_str(), sizeof(mqttUserBuffer));
  strlcpy(mqttPasswordBuffer, config.mqttPassword.c_str(), sizeof(mqttPasswordBuffer));
  strlcpy(deviceNameBuffer, config.deviceName.c_str(), sizeof(deviceNameBuffer));

  mqttHostParameter.setValue(mqttHostBuffer, sizeof(mqttHostBuffer));
  mqttPortParameter.setValue(mqttPortBuffer, sizeof(mqttPortBuffer));
  mqttUserParameter.setValue(mqttUserBuffer, sizeof(mqttUserBuffer));
  mqttPasswordParameter.setValue(mqttPasswordBuffer, sizeof(mqttPasswordBuffer));
  deviceNameParameter.setValue(deviceNameBuffer, sizeof(deviceNameBuffer));
}

bool readWiFiManagerParameters() {
  String newHost = mqttHostParameter.getValue();
  String newPort = mqttPortParameter.getValue();
  String newUser = mqttUserParameter.getValue();
  String newPassword = mqttPasswordParameter.getValue();
  String newDeviceName = deviceNameParameter.getValue();

  newHost.trim();
  newPort.trim();
  newUser.trim();
  newDeviceName.trim();

  uint16_t port = 0;

  if (newHost.length() == 0 ||
      newHost.length() >= sizeof(mqttHostBuffer) ||
      !isValidMQTTPort(newPort, port) ||
      newUser.length() >= sizeof(mqttUserBuffer) ||
      newPassword.length() >= sizeof(mqttPasswordBuffer) ||
      newDeviceName.length() == 0 ||
      newDeviceName.length() >= sizeof(deviceNameBuffer)) {
    return false;
  }

  pendingConfig.mqttHost = newHost;
  pendingConfig.mqttPort = port;
  pendingConfig.mqttUser = newUser;
  pendingConfig.mqttPassword = newPassword;
  pendingConfig.deviceName = newDeviceName;

  return true;
}

void configureWiFiManager() {
  // WiFiManager is configured on port 81 to avoid conflict with port 80.
  wifiManager.setConfigPortalBlocking(false);
  wifiManager.setConnectTimeout(10);
  wifiManager.setConfigPortalTimeout(0);
  wifiManager.setCaptivePortalEnable(true);
  wifiManager.setHttpPort(81);

  wifiManager.setAPStaticIPConfig(
    IPAddress(192, 168, 4, 1),
    IPAddress(192, 168, 4, 1),
    IPAddress(255, 255, 255, 0)
  );

  wifiManager.addParameter(&mqttHostParameter);
  wifiManager.addParameter(&mqttPortParameter);
