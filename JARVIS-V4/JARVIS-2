void serviceCallingBells() {
  uint32_t now = millis();

  for (uint8_t i = 0; i < 4; i++) {
    if (!updateDebouncedInput(
          bellOptos[i], now, BELL_DEBOUNCE_TIME
        )) continue;

    bellStates[i] = bellOptos[i].stableState;

    if (!bellStates[i]) {
      if (mqttClient.connected()) {
        mqttClient.publish(
          topicForBell(lockIds[i]).c_str(),
          "RELEASED",
          false
        );
      }
      continue;
    }

    Serial.printf("[BELL] %s PRESSED\n", lockNames[i]);
    publishBellEvent(i);

    if (!lockStates[i])
      setLockOutput(i, true);
  }
}

// ================================================================
// MQTT COMMAND VALIDATION
// ================================================================

bool parseMQTTCommandTopic(
  const String &topic,
  String &deviceID
) {
  String prefix = mqttBaseTopic + "/";

  if (!topic.startsWith(prefix) || !topic.endsWith("/cmd"))
    return false;

  String middle = topic.substring(
    prefix.length(), topic.length() - 4
  );

  if (middle.length() == 0 || middle.indexOf('/') >= 0)
    return false;

  middle.toLowerCase();

  if (middle != "gate" &&
      middle != "maingate" &&
      middle != "mainlock" &&
      middle != "bd1" &&
      middle != "blc" &&
      middle != "bd2") return false;

  deviceID = middle;
  return true;
}

void mqttCallback(
  char *topic,
  byte *payload,
  unsigned int length
) {
  if (length == 0 || length > 64) {
    Serial.println("[MQTT] Rejected: invalid payload length");
    return;
  }

  String deviceID;

  if (!parseMQTTCommandTopic(String(topic), deviceID)) {
    Serial.println("[MQTT] Rejected: unknown command topic");
    return;
  }

  String command;
  command.reserve(length + 1);

  for (unsigned int i = 0; i < length; i++) {
    char c = (char)payload[i];

    if (c == '\0' || (uint8_t)c < 0x20) {
      Serial.println("[MQTT] Rejected: invalid payload character");
      return;
    }

    command += c;
  }

  command.trim();
  command.toUpperCase();

  bool valid = false;

  if (deviceID == "gate" || deviceID == "maingate") {
    valid = command == "ON" || command == "OFF" ||
            command == "OPEN" || command == "CLOSE" ||
            command == "STOP";
  } else {
    valid = command == "LOCK" || command == "UNLOCK";
  }

  if (!valid) {
    Serial.printf("[MQTT] Rejected invalid command: %s\n",
                  command.c_str());
    return;
  }

  CommandResult result = executeHardwareByID(deviceID, command);

  Serial.printf("[MQTT] %s: %s -> %s\n",
                result.ok ? "Accepted" : "Failed",
                deviceID.c_str(),
                command.c_str());
}

