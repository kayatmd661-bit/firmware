bool clearPreferencesNamespace(const char *nameSpace) {
  if (!preferences.begin(nameSpace, false)) {
    Serial.printf("[NVS] Cannot open namespace: %s\n", nameSpace);
    return false;
  }

  bool result = preferences.clear();
  preferences.end();

  Serial.printf("[NVS] Clear %s: %s\n",
                nameSpace, result ? "OK" : "FAILED");
  return result;
}

bool saveWiFiCredentials(const String &ssid, const String &password) {
  if (ssid.length() == 0 || ssid.length() > 32 || password.length() > 64) {
    Serial.println("[NVS] Invalid WiFi credentials; not saved");
    return false;
  }

  if (!preferences.begin("jarvis_wifi", false)) {
    Serial.println("[NVS] Cannot open jarvis_wifi");
    return false;
  }

  size_t ssidWritten = preferences.putString("ssid", ssid);
  size_t passWritten = preferences.putString("password", password);

  String verifySSID = preferences.getString("ssid", "");
  String verifyPassword = preferences.getString("password", "");

  preferences.end();

  bool success =
    (ssidWritten > 0) &&
    (password.length() == 0 || passWritten > 0) &&
    (verifySSID == ssid) &&
    (verifyPassword == password);

  Serial.println(success
    ? "[NVS] WiFi credentials saved and verified"
    : "[NVS] ERROR: WiFi credential save/verify failed");

  return success;
}

bool loadWiFiCredentials() {
  savedWiFiSSID = "";
  savedWiFiPassword = "";

  if (!preferences.begin("jarvis_wifi", true)) {
    Serial.println("[NVS] Cannot read jarvis_wifi");
    return false;
  }

  savedWiFiSSID = preferences.getString("ssid", "");
  savedWiFiPassword = preferences.getString("password", "");

  preferences.end();

  if (savedWiFiSSID.length() == 0 || savedWiFiSSID.length() > 32 ||
      savedWiFiPassword.length() > 64) {
    savedWiFiSSID = "";
    savedWiFiPassword = "";
    Serial.println("[NVS] No valid saved WiFi credentials");
    return false;
  }

  Serial.print("[NVS] Saved WiFi SSID loaded: ");
  Serial.println(savedWiFiSSID);
  Serial.println("[NVS] WiFi password loaded: [HIDDEN]");
  return true;
}

bool saveConfiguration(const DeviceConfig &data) {
  if (!preferences.begin("jarvis_config", false)) {
    Serial.println("[NVS] Cannot open jarvis_config");
    return false;
  }

  size_t hostWritten = preferences.putString("mqtt_host", data.mqttHost);
  size_t portWritten = preferences.putUShort("mqtt_port", data.mqttPort);
  size_t userWritten = preferences.putString("mqtt_user", data.mqttUser);
  size_t passWritten = preferences.putString("mqtt_pass", data.mqttPassword);
  size_t nameWritten = preferences.putString("device_name", data.deviceName);

  bool verified =
    preferences.getString("mqtt_host", "") == data.mqttHost &&
    preferences.getUShort("mqtt_port", 0) == data.mqttPort &&
    preferences.getString("mqtt_user", "") == data.mqttUser &&
    preferences.getString("mqtt_pass", "") == data.mqttPassword &&
    preferences.getString("device_name", "") == data.deviceName;

  preferences.end();

  bool success =
    (hostWritten > 0) &&
    (portWritten > 0) &&
    (nameWritten > 0) &&
    (data.mqttUser.length() == 0 || userWritten > 0) &&
    (data.mqttPassword.length() == 0 || passWritten > 0) &&
    verified;

  Serial.println(success
    ? "[NVS] MQTT configuration saved and verified"
    : "[NVS] ERROR: MQTT configuration save/verify failed");

  return success;
}

void loadConfiguration() {
  config.mqttHost = MQTT_DEFAULT_HOST;
  config.mqttPort = MQTT_DEFAULT_PORT;
  config.mqttUser = MQTT_DEFAULT_USER;
  config.mqttPassword = "";
  config.deviceName = DEVICE_NAME;

  if (!preferences.begin("jarvis_config", true)) {
    Serial.println("[NVS] Cannot read configuration; using defaults");
    return;
  }

  String host = preferences.getString("mqtt_host", MQTT_DEFAULT_HOST);
  uint16_t port = preferences.getUShort("mqtt_port", MQTT_DEFAULT_PORT);
  String user = preferences.getString("mqtt_user", MQTT_DEFAULT_USER);
  String password = preferences.getString("mqtt_pass", "");
  String name = preferences.getString("device_name", DEVICE_NAME);

  preferences.end();

  if (host.length() > 0 && host.length() < sizeof(mqttHostBuffer))
    config.mqttHost = host;

  if (port >= 1 && port <= 65535)
    config.mqttPort = port;

  if (user.length() < sizeof(mqttUserBuffer))
    config.mqttUser = user;

  if (password.length() < sizeof(mqttPasswordBuffer))
    config.mqttPassword = password;

  if (name.length() > 0 && name.length() < sizeof(deviceNameBuffer))
    config.deviceName = name;

  Serial.println("[NVS] MQTT configuration loaded");
  Serial.printf("[NVS] MQTT host: %s\n", config.mqttHost.c_str());
  Serial.printf("[NVS] MQTT port: %u\n", config.mqttPort);
  Serial.printf("[NVS] MQTT user: %s\n", config.mqttUser.c_str());
  Serial.printf("[NVS] Device name: %s\n", config.deviceName.c_str());
  Serial.println("[NVS] MQTT password: [HIDDEN]");
}

