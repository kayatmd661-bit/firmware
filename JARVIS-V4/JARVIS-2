// ================================================================

void handlePortalRoot() {
  portalServer.send(200, "text/html; charset=utf-8", portalHTML());
}

void handlePortalRedirect() {
  portalServer.sendHeader("Location", "http://192.168.4.1/", true);
  portalServer.send(302, "text/plain", "");
}

void handlePortalNotFound() {
  portalServer.sendHeader("Location", "http://192.168.4.1/", true);
  portalServer.send(302, "text/plain", "");
}

void handlePortalSave() {
  if (!portalServer.hasArg("ssid") ||
      !portalServer.hasArg("wifi_password")) {
    portalServer.send(
      400, "text/html; charset=utf-8",
      "<html><body><h3>WiFi SSID or password field is missing</h3><a href='/'>Go back</a></body></html>"
    );
    return;
  }

  String ssid = portalServer.arg("ssid");
  String wifiPassword = portalServer.arg("wifi_password");

  // Trim SSID whitespace only. Password whitespace is preserved.
  ssid.trim();

  String newHost = portalServer.arg("mqtt_host");
  String newPort = portalServer.arg("mqtt_port");
  String newUser = portalServer.arg("mqtt_user");
  String newPassword = portalServer.arg("mqtt_password");
  String newDeviceName = portalServer.arg("device_name");

  newHost.trim();
  newPort.trim();
  newUser.trim();
  newDeviceName.trim();

  if (ssid.length() == 0 || ssid.length() > 32) {
    portalServer.send(
      400, "text/html; charset=utf-8",
      "<html><body><h3>Invalid WiFi SSID</h3><a href='/'>Go back</a></body></html>"
    );
    return;
  }

  if (!isValidWiFiPassword(wifiPassword)) {
    portalServer.send(
      400, "text/html; charset=utf-8",
      "<html><body><h3>WiFi password must be empty or 8-63 characters, or a 64-character hexadecimal PSK</h3><a href='/'>Go back</a></body></html>"
    );
    return;
  }

  if (newHost.length() == 0 ||
      newHost.length() >= sizeof(mqttHostBuffer) ||
      newUser.length() >= sizeof(mqttUserBuffer) ||
      newPassword.length() >= sizeof(mqttPasswordBuffer) ||
      newDeviceName.length() == 0 ||
      newDeviceName.length() >= sizeof(deviceNameBuffer)) {
    portalServer.send(
      400, "text/html; charset=utf-8",
      "<html><body><h3>Invalid MQTT or device settings</h3><a href='/'>Go back</a></body></html>"
    );
    return;
  }

  uint16_t port = 0;

  if (!isValidMQTTPort(newPort, port)) {
    portalServer.send(
      400, "text/html; charset=utf-8",
      "<html><body><h3>MQTT port must be between 1 and 65535</h3><a href='/'>Go back</a></body></html>"
    );
    return;
  }

  pendingConfig.mqttHost = newHost;
  pendingConfig.mqttPort = port;
  pendingConfig.mqttUser = newUser;
  pendingConfig.mqttPassword = newPassword;
  pendingConfig.deviceName = newDeviceName;

  pendingWiFiSSID = ssid;
  pendingWiFiPassword = wifiPassword;
  pendingCredentialsValid = true;

  wifiHasSavedCredentials = wifiHasSavedCredentials || (savedWiFiSSID.length() > 0);
  wifiFallbackTriggered = false;
  wifiConnectStartedAt = millis();

  portalReconnectPending = true;
  portalReconnectStarted = false;
  portalReconnectAt = millis();

  String response =
    "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<meta charset='UTF-8'><title>JARVIS Saved</title></head>"
    "<body style='font-family:Arial,sans-serif;padding:25px;background:#101820;color:#eee'>"
    "<h2 style='color:#00d4ff'>Settings Received</h2>"
    "<p>Connecting to WiFi network <b>" + htmlEscape(ssid) + "</b>...</p>"
    "<p>WiFi and MQTT settings will be stored permanently once connection succeeds.</p>"
    "<p>You may now switch back to your home Wi-Fi network.</p></body></html>";

  portalServer.send(200, "text/html; charset=utf-8", response);

  Serial.println("[PORTAL] Configuration submitted");
  Serial.printf("[PORTAL] SSID received: %s\n", ssid.c_str());
  Serial.println("[PORTAL] WiFi password: [HIDDEN]");
  Serial.printf("[PORTAL] MQTT host: %s\n", newHost.c_str());
  Serial.printf("[PORTAL] MQTT port: %u\n", port);
  Serial.println("[PORTAL] MQTT password: [HIDDEN]");
}

