// ================================================================

void onWiFiEvent(WiFiEvent_t event, WiFiEventInfo_t info) {
  switch (event) {
    case ARDUINO_EVENT_WIFI_STA_CONNECTED:
      Serial.println("[WiFi] Access point connected");
      break;

    case ARDUINO_EVENT_WIFI_STA_GOT_IP:
      Serial.println("[WiFi] Connected successfully");
      Serial.printf("[WiFi] IP: %s\n", WiFi.localIP().toString().c_str());
      Serial.printf("[WiFi] Gateway: %s\n", WiFi.gatewayIP().toString().c_str());
      Serial.printf("[WiFi] RSSI: %d dBm\n", WiFi.RSSI());

      wifiHasSavedCredentials = true;
      wifiFallbackTriggered = false;
      wifiWasConnected = true;
      break;

    case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
      Serial.printf("[WiFi] Disconnected. Reason code: %u\n",
                    info.wifi_sta_disconnected.reason);

      mqttConnected = false;

      if (wifiWasConnected) {
        wifiWasConnected = false;
        wifiConnectStartedAt = millis();
        wifiFallbackTriggered = false;
      }
      break;

    case ARDUINO_EVENT_WIFI_AP_START:
      Serial.println("[WiFi] Setup AP started: 192.168.4.1");
      break;

    case ARDUINO_EVENT_WIFI_AP_STOP:
      Serial.println("[WiFi] Setup AP stopped");
      break;

    default:
      break;
  }
}

// ================================================================
// WIFI STATUS LED (GPIO 2)
// ================================================================

void setStatusLed(bool on) {
  digitalWrite(PIN_WIFI_LED, (STATUS_LED_ACTIVE_LOW ? !on : on) ? HIGH : LOW);
}

void serviceWiFiStatusLED() {
  uint32_t now = millis();

  if (WiFi.status() == WL_CONNECTED) {
    wifiLedState = true;
    setStatusLed(true);
    return;
  }

  if (wifiPortalStarted) {
    if (elapsed(now, wifiLedChangedAt, WIFI_PORTAL_LED_INTERVAL)) {
      wifiLedChangedAt = now;
      wifiLedState = !wifiLedState;
    }

    setStatusLed(wifiLedState);
    return;
  }

  wifiLedState = false;
  setStatusLed(false);
}

