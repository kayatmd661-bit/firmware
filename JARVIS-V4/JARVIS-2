void publishAllStates() {
  if (!mqttClient.connected()) return;

  for (uint8_t i = 0; i < 4; i++) {
    mqttClient.publish(
      topicForState(lockIds[i]).c_str(),
      lockStates[i] ? "LOCKED" : "UNLOCKED",
      true
    );

    mqttClient.publish(
      (mqttBaseTopic + "/" + String(lockIds[i]) + "/opto").c_str(),
      optoStates[i] ? "ON" : "OFF",
      true
    );
  }

  const char *stateText = "IDLE";

  switch (gateState) {
    case GATE_OPEN_UNLOCK_WAIT: stateText = "UNLOCKING"; break;
    case GATE_OPENING:          stateText = "OPENING"; break;
    case GATE_CLOSING:          stateText = "CLOSING"; break;
    case GATE_CLOSE_LOCK_WAIT:  stateText = "CLOSE_WAIT_LOCK"; break;
    case GATE_FAULT:            stateText = "FAULT"; break;
    default:
      if (gateOpenLimit) stateText = "OPEN";
      else if (gateCloseLimit && lockStates[0]) stateText = "CLOSED_LOCKED";
      else if (gateCloseLimit) stateText = "CLOSED";
      break;
  }

  mqttClient.publish(
    (mqttBaseTopic + "/gate/state").c_str(),
    stateText,
    true
  );
}

// ================================================================
// MQTT CONNECTION
// ================================================================

void configureMQTT() {
  mqttBaseTopic = String(DEVICE_ID);
  mqttAvailabilityTopic = mqttBaseTopic + "/availability";

  mqttClient.setServer(config.mqttHost.c_str(), config.mqttPort);
  mqttClient.setCallback(mqttCallback);
  mqttClient.setKeepAlive(MQTT_KEEPALIVE);
  mqttClient.setSocketTimeout(MQTT_SOCKET_TIMEOUT);
  mqttClient.setBufferSize(2048);
}

void serviceMQTT() {
  uint32_t now = millis();

  if (WiFi.status() != WL_CONNECTED) {
    mqttConnected = false;
    return;
  }

  if (mqttClient.connected()) {
    mqttClient.loop();
    mqttConnected = true;
    return;
  }

  mqttConnected = false;
  discoveryPublished = false;

  if (!elapsed(now, lastMQTTAttempt, MQTT_RETRY_INTERVAL))
    return;

  lastMQTTAttempt = now;

  Serial.printf("[MQTT] Connecting to %s:%u\n",
                config.mqttHost.c_str(), config.mqttPort);

  String clientID =
    String(DEVICE_ID) + "_" +
    String((uint32_t)ESP.getEfuseMac(), HEX);

  bool connected;

  if (config.mqttUser.length() > 0) {
    connected = mqttClient.connect(
      clientID.c_str(),
      config.mqttUser.c_str(),
      config.mqttPassword.c_str(),
      mqttAvailabilityTopic.c_str(),
      0,
      true,
      "offline"
    );
  } else {
    connected = mqttClient.connect(
      clientID.c_str(),
      mqttAvailabilityTopic.c_str(),
      0,
      true,
      "offline"
    );
  }

  if (!connected) {
    Serial.printf("[MQTT] Connection failed. State: %d\n",
                  mqttClient.state());
    return;
  }

  mqttConnected = true;
  Serial.println("[MQTT] Connected");

  mqttClient.publish(mqttAvailabilityTopic.c_str(), "online", true);
  mqttClient.subscribe((mqttBaseTopic + "/+/cmd").c_str());

  publishAllDiscovery();
  publishAllStates();
}

