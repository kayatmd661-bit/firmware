void initializeWiFiDriver() {
  if (wifiDriverReady) return;

  Serial.println("[WiFi] Initializing driver...");
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  esp_wifi_set_ps(WIFI_PS_NONE);
  wifiDriverReady = true;

  Serial.println("[WiFi] Driver initialized (WIFI_PS_NONE active)");
}

bool eraseWiFiCredentials() {
  Serial.println("[WiFi] Erasing WiFi credentials...");

  if (!wifiDriverReady)
    initializeWiFiDriver();

  WiFi.disconnect(false, true);

  esp_err_t result = esp_wifi_restore();

  if (result == ESP_OK)
    Serial.println("[WiFi] ESP WiFi configuration restored");
  else
    Serial.printf("[WiFi] esp_wifi_restore code: %d\n", (int)result);

  clearPreferencesNamespace("jarvis_wifi");

  WiFi.mode(WIFI_STA);
  savedWiFiSSID = "";
  savedWiFiPassword = "";

  return (result == ESP_OK || result == ESP_ERR_WIFI_NOT_INIT);
}

void checkFirmwareConfigurationSchema() {
  Serial.println("[MIGRATION] Checking configuration schema...");

  uint16_t storedSchema = 0;

  if (preferences.begin("jarvis_meta", true)) {
    storedSchema = preferences.getUShort("schema", 0);
    preferences.end();
  }

  Serial.printf("[MIGRATION] Stored=%u Firmware=%u\n",
                storedSchema, FIRMWARE_CONFIG_SCHEMA);

  if (storedSchema == FIRMWARE_CONFIG_SCHEMA) {
    Serial.println("[MIGRATION] Schema matches");
    return;
  }

  // On first boot with new schema, stamp schema marker without wiping user data
  if (storedSchema == 0) {
    Serial.println("[MIGRATION] Initializing schema marker...");
    if (preferences.begin("jarvis_meta", false)) {
      preferences.putUShort("schema", FIRMWARE_CONFIG_SCHEMA);
      preferences.end();
      Serial.println("[MIGRATION] Initial schema registered");
    }
    return;
  }

  // Upgrading from an incompatible older schema version
  Serial.println("[MIGRATION] Clearing old configuration...");

  bool configCleared = clearPreferencesNamespace("jarvis_config");
  bool locksCleared = clearPreferencesNamespace("jarvis_v4_final");
  bool wifiCleared = eraseWiFiCredentials();

  if (!configCleared || !locksCleared || !wifiCleared) {
    Serial.println("[MIGRATION] Cleanup failed; schema unchanged");
    return;
  }

  if (preferences.begin("jarvis_meta", false)) {
    size_t written = preferences.putUShort("schema", FIRMWARE_CONFIG_SCHEMA);
    preferences.end();
    Serial.println(written > 0
      ? "[MIGRATION] New schema saved"
      : "[MIGRATION] Schema save failed");
  }
}

// ================================================================
// LOCK HARDWARE
// ================================================================

bool setLockOutput(uint8_t index, bool locked) {
  if (index >= 4) return false;

  if (index == 0 && locked && !isGateCloseLimitActive()) {
    Serial.println("[LOCK] Main lock rejected: Close Limit inactive");

    if (mqttClient.connected()) {
      mqttClient.publish(
        (mqttBaseTopic + "/mainlock/error").c_str(),
        "CLOSE_LIMIT_NOT_ACTIVE",
        false
      );
    }

    return false;
  }

  digitalWrite(lockPins[index], locked ? HIGH : LOW);
  lockStates[index] = locked;
  saveLockStates();

  Serial.printf("[LOCK] %s -> %s\n",
                lockNames[index], locked ? "LOCKED" : "UNLOCKED");

  if (mqttClient.connected()) {
    mqttClient.publish(
      topicForState(lockIds[index]).c_str(),
      locked ? "LOCKED" : "UNLOCKED",
      true
    );
  }

  return true;
}

void applySavedLockStates() {
  for (uint8_t i = 0; i < 4; i++) {
    bool requestedState = lockStates[i];

    if (i == 0 && requestedState && !isGateCloseLimitActive()) {
      requestedState = false;
      lockStates[i] = false;
      Serial.println("[LOCK] Main lock state rejected: Close Limit inactive");
    }

    digitalWrite(lockPins[i], requestedState ? HIGH : LOW);
  }

  if (!lockStates[0])
    saveLockStates();
}

