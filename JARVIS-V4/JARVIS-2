// ================================================================
// WIFI PORTAL START / STOP
// ================================================================

void stopWiFiPortal() {
  if (!wifiPortalStarted) return;

  Serial.println("[WiFi] Stopping captive portal...");

  portalDNS.stop();
  portalServer.stop();

  wifiPortalStarted = false;
  portalReconnectPending = false;
  portalReconnectStarted = false;

  Serial.println("[WiFi] Captive DNS and HTTP stopped");
}

void startWiFiPortal() {
  if (wifiPortalStarted) return;

  if (!wifiDriverReady)
    initializeWiFiDriver();

  uint32_t now = millis();

  if (lastPortalAttempt != 0 &&
      !elapsed(now, lastPortalAttempt, WIFI_PORTAL_RETRY_INTERVAL)) {
    return;
  }

  lastPortalAttempt = now;

  Serial.println("[WiFi] Starting dedicated captive portal...");

  stopDashboardServer();
  portalDNS.stop();
  portalServer.stop();

  if (wifiManager.getConfigPortalActive())
    wifiManager.stopConfigPortal();

  WiFi.softAPdisconnect(true);
  WiFi.disconnect(false, false);

  WiFi.mode(WIFI_AP_STA);
  esp_wifi_set_ps(WIFI_PS_NONE);

  IPAddress apIP(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);

  if (!WiFi.softAPConfig(apIP, gateway, subnet)) {
    Serial.println("[WiFi] ERROR: softAPConfig failed");
    WiFi.mode(WIFI_STA);
    wifiPortalStarted = false;
    return;
  }

  if (!WiFi.softAP("JARVIS-V4-SETUP", nullptr, 1, false, 4)) {
    Serial.println("[WiFi] ERROR: softAP start failed");
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    wifiPortalStarted = false;
    return;
  }

  IPAddress actualIP = WiFi.softAPIP();
  Serial.printf("[WiFi] AP IP: %s\n", actualIP.toString().c_str());

  if (actualIP != apIP) {
    Serial.println("[WiFi] ERROR: Unexpected AP address");
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    wifiPortalStarted = false;
    return;
  }

  if (!portalDNS.start(PORTAL_DNS_PORT, "*", apIP)) {
    Serial.println("[WiFi] ERROR: Captive DNS start failed");
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    wifiPortalStarted = false;
    return;
  }

  configurePortalServer();
  portalServer.begin();

  wifiPortalStarted = true;
  wifiLedState = false;
  wifiLedChangedAt = millis();

  portalReconnectPending = false;
  portalReconnectStarted = false;

  Serial.println("[WiFi] Captive portal ready");
  Serial.println("[WiFi] AP: JARVIS-V4-SETUP");
  Serial.println("[WiFi] URL: http://192.168.4.1");
  Serial.println("[WiFi] Wildcard DNS enabled");
}

// ================================================================
// WIFI PORTAL SERVICE
// ================================================================

void serviceWiFiPortal() {
  if (!wifiPortalStarted) return;

  portalDNS.processNextRequest();
  portalServer.handleClient();

  if (!portalReconnectPending ||
      !pendingCredentialsValid ||
      !elapsed(millis(), portalReconnectAt, PORTAL_SAVE_RECONNECT_DELAY)) {
    return;
  }

  if (portalReconnectStarted) return;
  portalReconnectStarted = true;

  Serial.println("[WiFi] Applying submitted credentials...");

  stopWiFiPortal();

  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  esp_wifi_set_ps(WIFI_PS_NONE);
  WiFi.setAutoReconnect(false);
  WiFi.disconnect(false, false);

  WiFi.begin(
    pendingWiFiSSID.c_str(),
    pendingWiFiPassword.c_str()
  );

  wifiConnectStartedAt = millis();
  lastWiFiAttempt = millis();
  wifiFallbackTriggered = false;
  wifiWasConnected = false;

  portalReconnectPending = false;

  Serial.printf("[WiFi] Station connection started for SSID: %s\n",
                pendingWiFiSSID.c_str());
}

// ================================================================
// WIFI INITIAL CONNECTION
// ================================================================

void startInitialWiFiConnection() {
  if (wifiConnectionStarted) return;

  if (!wifiDriverReady)
    initializeWiFiDriver();

  wifiConnectionStarted = true;

  WiFi.persistent(false);
  WiFi.setAutoReconnect(false);

  if (!loadWiFiCredentials()) {
    wifiHasSavedCredentials = false;
    wifiConnectStartedAt = 0;

    Serial.println("[WiFi] No saved credentials; starting setup portal");
    startWiFiPortal();
    return;
  }

  wifiHasSavedCredentials = true;

  WiFi.mode(WIFI_STA);
  esp_wifi_set_ps(WIFI_PS_NONE);

  Serial.printf("[WiFi] Connecting with saved SSID: %s\n",
                savedWiFiSSID.c_str());

  WiFi.begin(savedWiFiSSID.c_str(), savedWiFiPassword.c_str());

  wifiConnectStartedAt = millis();
  lastWiFiAttempt = millis();
}

// ================================================================
// WIFI CONNECTION PERSISTENCE
// ================================================================

void persistConnectedCredentials() {
  if (!pendingCredentialsValid) {
    if (savedWiFiSSID.length() == 0)
      loadWiFiCredentials();
    return;
  }

  if (WiFi.status() != WL_CONNECTED || WiFi.localIP() == IPAddress(0, 0, 0, 0)) {
    return;
  }

  String connectedSSID = WiFi.SSID();
  if (connectedSSID.length() > 0 && connectedSSID != pendingWiFiSSID) {
    Serial.printf("[NVS] Connected SSID '%s' does not match pending '%s'\n",
                  connectedSSID.c_str(), pendingWiFiSSID.c_str());
    return;
  }

  Serial.println("[NVS] Connection established; saving credentials to NVS...");

  bool wifiSaved = saveWiFiCredentials(pendingWiFiSSID, pendingWiFiPassword);
  bool mqttSaved = saveConfiguration(pendingConfig);

  if (wifiSaved && mqttSaved) {
    savedWiFiSSID = pendingWiFiSSID;
    savedWiFiPassword = pendingWiFiPassword;
    wifiHasSavedCredentials = true;

    config = pendingConfig;
    copyConfigToBuffers();
    configureMQTT();

    Serial.println("[WiFi] New WiFi and MQTT settings committed to NVS");
    pendingCredentialsValid = false;
    pendingWiFiSSID = "";
    pendingWiFiPassword = "";
  } else {
    Serial.println("[NVS] ERROR: One or more settings were not persisted");
  }
}

// ================================================================
// WIFI SERVICE
// ================================================================

void serviceWiFi() {
  uint32_t now = millis();

  if (WiFi.status() == WL_CONNECTED) {
    if (wifiPortalStarted)
      stopWiFiPortal();

    if (pendingCredentialsValid)
      persistConnectedCredentials();

    if (!dashboardServerStarted)
      startDashboardServer();

    if (!mdnsStarted) {
      if (MDNS.begin("jarvis-v4")) {
        MDNS.addService("http", "tcp", 80);
        mdnsStarted = true;
        Serial.println("[mDNS] Started: http://jarvis-v4.local/");
      } else {
        Serial.println("[mDNS] Start failed");
      }
    }

    return;
  }

  if (wifiPortalStartRequested) {
    wifiPortalStartRequested = false;
    startWiFiPortal();
  }

  if (wifiPortalStarted) {
    serviceWiFiPortal();
    return;
  }

  if (!wifiHasSavedCredentials && !pendingCredentialsValid) {
    if (lastPortalAttempt == 0 ||
        elapsed(now, lastPortalAttempt, WIFI_PORTAL_RETRY_INTERVAL)) {
      startWiFiPortal();
    }
    return;
  }

  if (wifiConnectStartedAt != 0 &&
      !wifiFallbackTriggered &&
      elapsed(now, wifiConnectStartedAt, WIFI_PORTAL_FALLBACK)) {
    wifiFallbackTriggered = true;

    Serial.println("[WiFi] Connection timeout; starting setup portal");
    startWiFiPortal();
    return;
  }

  if (elapsed(now, lastWiFiAttempt, WIFI_RETRY_INTERVAL)) {
    lastWiFiAttempt = now;

    Serial.println("[WiFi] Retrying saved credentials...");

    if (pendingCredentialsValid) {
      WiFi.begin(
        pendingWiFiSSID.c_str(),
        pendingWiFiPassword.c_str()
      );
    } else if (savedWiFiSSID.length() > 0) {
      WiFi.begin(
        savedWiFiSSID.c_str(),
        savedWiFiPassword.c_str()
      );
    } else {
      loadWiFiCredentials();

      if (savedWiFiSSID.length() > 0) {
        WiFi.begin(
          savedWiFiSSID.c_str(),
          savedWiFiPassword.c_str()
        );
      }
    }
  }
}

