bool isGateOpenLimitActive() {
  return digitalRead(PIN_LIMIT_OPEN) == LOW;
}

bool isGateCloseLimitActive() {
  return digitalRead(PIN_LIMIT_CLOSE) == LOW;
}

void stopGateMotor() {
  digitalWrite(PIN_GATE_FWD, LOW);
  digitalWrite(PIN_GATE_REV, LOW);
  gateMotorRunning = false;
}

void cancelGateTimers() {
  gateStateStartedAt = 0;
  gateMotorStartedAt = 0;
}

void publishGateState(const char *state) {
  if (mqttClient.connected()) {
    mqttClient.publish(
      (mqttBaseTopic + "/gate/state").c_str(),
      state,
      true
    );
  }
}

void setGateFault(const String &reason) {
  stopGateMotor();
  gateState = GATE_FAULT;
  gateFaultMessage = reason;
  cancelGateTimers();

  Serial.printf("[GATE] FAULT: %s\n", reason.c_str());

  if (mqttClient.connected()) {
    mqttClient.publish(
      (mqttBaseTopic + "/gate/fault").c_str(),
      reason.c_str(),
      true
    );
  }

  publishGateState("FAULT");
}

void beginGateOpen() {
  stopGateMotor();
  cancelGateTimers();
  gateFaultMessage = "";

  gateOpenLimit = isGateOpenLimitActive();
  gateCloseLimit = isGateCloseLimitActive();

  if (gateOpenLimit && gateCloseLimit) {
    setGateFault("LIMIT_SWITCH_CONFLICT");
    return;
  }

  if (gateOpenLimit) {
    gateState = GATE_IDLE;
    publishGateState("OPEN");
    Serial.println("[GATE] Already open");
    return;
  }

  if (!setLockOutput(0, false)) {
    setGateFault("MAIN_LOCK_RELEASE_FAILED");
    return;
  }

  gateState = GATE_OPEN_UNLOCK_WAIT;
  gateStateStartedAt = millis();

  Serial.println("[GATE] Unlock wait started");
  publishGateState("UNLOCKING");
}

void beginGateClose() {
  stopGateMotor();
  cancelGateTimers();
  gateFaultMessage = "";

  gateOpenLimit = isGateOpenLimitActive();
  gateCloseLimit = isGateCloseLimitActive();

  if (gateOpenLimit && gateCloseLimit) {
    setGateFault("LIMIT_SWITCH_CONFLICT");
    return;
  }

  if (gateCloseLimit) {
    gateState = GATE_CLOSE_LOCK_WAIT;
    gateStateStartedAt = millis();

    Serial.println("[GATE] Close Limit active; lock wait started");
    publishGateState("CLOSE_WAIT_LOCK");
    return;
  }

  gateState = GATE_CLOSING;
  gateMotorStartedAt = millis();

  digitalWrite(PIN_GATE_FWD, LOW);
  digitalWrite(PIN_GATE_REV, HIGH);
  gateMotorRunning = true;

  Serial.println("[GATE] Closing motor started");
  publishGateState("CLOSING");
}

void stopGateOperation() {
  stopGateMotor();
  cancelGateTimers();
  gateState = GATE_IDLE;

  Serial.println("[GATE] Operation stopped");
  publishGateState("STOPPED");
}

void serviceGateStateMachine() {
  uint32_t now = millis();

  gateOpenLimit = isGateOpenLimitActive();
  gateCloseLimit = isGateCloseLimitActive();

  if (gateOpenLimit && gateCloseLimit) {
    if (gateState != GATE_FAULT)
      setGateFault("LIMIT_SWITCH_CONFLICT");
    return;
  }

  switch (gateState) {
    case GATE_IDLE:
      break;

    case GATE_OPEN_UNLOCK_WAIT:
      if (elapsed(now, gateStateStartedAt, GATE_UNLOCK_WAIT_MS)) {
        if (gateOpenLimit) {
          gateState = GATE_IDLE;
          cancelGateTimers();
          publishGateState("OPEN");
          break;
        }

        digitalWrite(PIN_GATE_REV, LOW);
        digitalWrite(PIN_GATE_FWD, HIGH);

        gateMotorRunning = true;
        gateMotorStartedAt = now;
        gateState = GATE_OPENING;

        Serial.println("[GATE] Opening motor started");
        publishGateState("OPENING");
      }
      break;

    case GATE_OPENING:
      if (gateOpenLimit) {
        stopGateMotor();
        cancelGateTimers();
        gateState = GATE_IDLE;

        Serial.println("[GATE] Open Limit confirmed");
        publishGateState("OPEN");
        break;
      }

      if (elapsed(now, gateMotorStartedAt, GATE_MOTOR_TIMEOUT_MS))
        setGateFault("OPEN_TIMEOUT");
      break;

    case GATE_CLOSING:
      if (gateCloseLimit) {
        stopGateMotor();
        gateState = GATE_CLOSE_LOCK_WAIT;
        gateStateStartedAt = now;

        Serial.println("[GATE] Close Limit confirmed; motor stopped");
        publishGateState("CLOSE_WAIT_LOCK");
        break;
      }

      if (elapsed(now, gateMotorStartedAt, GATE_MOTOR_TIMEOUT_MS))
        setGateFault("CLOSE_TIMEOUT");
      break;

    case GATE_CLOSE_LOCK_WAIT:
      if (!gateCloseLimit) {
        setGateFault("CLOSE_LIMIT_LOST");
        break;
      }

      if (elapsed(now, gateStateStartedAt, GATE_CLOSE_LOCK_WAIT_MS)) {
        if (isGateCloseLimitActive()) {
          if (setLockOutput(0, true)) {
            gateState = GATE_IDLE;
            cancelGateTimers();

            Serial.println("[GATE] Closed and locked");
            publishGateState("CLOSED_LOCKED");
          } else {
            setGateFault("MAIN_LOCK_ACTIVATION_FAILED");
          }
        } else {
          setGateFault("CLOSE_LIMIT_LOST_BEFORE_LOCK");
        }
      }
      break;

    case GATE_FAULT:
      stopGateMotor();
      break;
  }
}

// ================================================================
// HARDWARE COMMAND EXECUTION
// ================================================================

CommandResult executeHardwareByID(
  const String &deviceID,
  const String &command
) {
  String id = deviceID;
  String cmd = command;

  id.trim();
  cmd.trim();
  id.toLowerCase();
  cmd.toUpperCase();

  if (id == "gate" || id == "maingate") {
    if (cmd == "ON" || cmd == "OPEN") {
      beginGateOpen();
      return { true, "Gate opening command processed" };
    }

    if (cmd == "OFF" || cmd == "CLOSE") {
      beginGateClose();
      return { true, "Gate closing command processed" };
    }

    if (cmd == "STOP") {
      stopGateOperation();
      return { true, "Gate stopped" };
    }

    return { false, "Invalid gate command" };
  }

  int lockIndex = -1;

  for (uint8_t i = 0; i < 4; i++) {
    if (id == lockIds[i]) {
      lockIndex = i;
      break;
    }
  }

  if (lockIndex < 0)
    return { false, "Unknown device ID" };

  if (cmd == "LOCK") {
    bool result = setLockOutput((uint8_t)lockIndex, true);
    return result
      ? CommandResult{ true, "Lock accepted" }
      : CommandResult{ false, "Lock rejected by safety interlock" };
  }

  if (cmd == "UNLOCK") {
    bool result = setLockOutput((uint8_t)lockIndex, false);
    return result
      ? CommandResult{ true, "Unlock accepted" }
      : CommandResult{ false, "Unlock failed" };
  }

  return { false, "Invalid lock command" };
}

// ================================================================
// INPUT DEBOUNCE / LOCAL BUTTONS
// ================================================================

bool updateDebouncedInput(
  DebouncedInput &input,
  uint32_t now,
  uint32_t debounceTime
) {
  bool raw = digitalRead(input.pin);

  bool active = input.activeLow
    ? raw == LOW
    : raw == HIGH;

  if (active != input.lastRawState) {
    input.lastRawState = active;
    input.changedAt = now;
  }

  if (elapsed(now, input.changedAt, debounceTime) &&
      input.stableState != active) {
    input.stableState = active;
    return true;
  }

  return false;
}

void serviceLocalButtons() {
  uint32_t now = millis();

  for (uint8_t i = 0; i < 4; i++) {
    if (!updateDebouncedInput(
          localButtons[i], now, INPUT_DEBOUNCE_TIME
        )) continue;

    if (!localButtons[i].stableState) continue;

    if (i == 0) {
      if (gateState == GATE_OPENING ||
          gateState == GATE_OPEN_UNLOCK_WAIT ||
          gateOpenLimit) {
        beginGateClose();
      } else {
        beginGateOpen();
      }
    } else {
      setLockOutput(i, !lockStates[i]);
    }
  }
}

