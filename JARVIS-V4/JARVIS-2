bool publishDiscovery(
  const String &component,
  const String &objectID,
  const String &friendlyName,
  const String &commandTopic,
  const String &stateTopic,
  const String &payloadOn,
  const String &payloadOff
) {
  String uniqueID = String(DEVICE_ID) + "_" + objectID;

  String configTopic =
    discoveryPrefix + "/" + component + "/" +
    String(DEVICE_ID) + "/" + objectID + "/config";

  String payload;
  payload.reserve(1000);

  payload += "{";
  payload += "\"name\":\"" + jsonEscape(friendlyName) + "\",";
  payload += "\"unique_id\":\"" + jsonEscape(uniqueID) + "\",";
  payload += "\"object_id\":\"" + jsonEscape(uniqueID) + "\",";
  payload += "\"command_topic\":\"" + jsonEscape(commandTopic) + "\",";
  payload += "\"state_topic\":\"" + jsonEscape(stateTopic) + "\",";
  payload += "\"availability_topic\":\"" + jsonEscape(mqttAvailabilityTopic) + "\",";
  payload += "\"payload_on\":\"" + jsonEscape(payloadOn) + "\",";
  payload += "\"payload_off\":\"" + jsonEscape(payloadOff) + "\",";
  payload += "\"device\":{";
  payload += "\"identifiers\":[\"" + jsonEscape(String(DEVICE_ID)) + "\"],";
  payload += "\"name\":\"" + jsonEscape(config.deviceName) + "\",";
  payload += "\"manufacturer\":\"" + jsonEscape(String(DEVICE_MANUF)) + "\",";
  payload += "\"model\":\"" + jsonEscape(String(DEVICE_MODEL)) + "\"";
  payload += "}}";

  bool sent = mqttClient.publish(
    configTopic.c_str(), payload.c_str(), true
  );

  if (!sent)
    Serial.printf("[MQTT] Discovery failed: %s\n", objectID.c_str());

  return sent;
}

