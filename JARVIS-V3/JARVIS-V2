const char* wifiDisconnectReasonText(uint8_t reason) {
  switch (reason) {
    case 1: return "unspecified failure";
    case 2: return "authentication expired";
    case 15: return "4-way handshake timeout (password/security mismatch possible)";
    case 200: return "beacon timeout / weak signal";
    case 201: return "SSID/AP not found (check 2.4 GHz network name)";
    case 202: return "authentication failed (check WiFi password)";
    case 203: return "association failed";
    case 204: return "handshake timeout (check password/WPA mode)";
    case 205: return "connection failed";
    case 206: return "AP TSF reset";
    case 207: return "roaming";
    case 208: return "association comeback time too long";
    case 209: return "SA query timeout";
    case 210: return "no AP found with compatible security";
    case 211: return "no AP found matching the configured authentication-mode threshold";
    case 212: return "no AP found meeting the configured RSSI threshold";
    default: return "unmapped ESP-IDF WiFi reason; check router and signal";
  }
}


