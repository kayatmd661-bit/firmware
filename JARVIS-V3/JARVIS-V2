void handleSaveConfig() {
  if (!authorizeDashboardRequest()) return;
  if (server.hasArg("mqtt_host")) mqttHost = server.arg("mqtt_host");
  if (server.hasArg("mqtt_port")) {
    int p = server.arg("mqtt_port").toInt();
    mqttPort = (uint16_t)((p >= 1 && p <= 65535) ? p : 1883);
  }
  if (server.hasArg("mqtt_user")) mqttUser = server.arg("mqtt_user");
  if (server.hasArg("mqtt_pass") && server.arg("mqtt_pass").length() > 0) mqttPass = server.arg("mqtt_pass");

  if (server.hasArg("ha_host")) haHost = server.arg("ha_host");
  if (server.hasArg("ha_port")) {
    int p = server.arg("ha_port").toInt();
    haPort = (uint16_t)((p >= 1 && p <= 65535) ? p : 8123);
  }
  if (server.hasArg("ha_name")) haName = server.arg("ha_name");
  if (server.hasArg("ha_id")) haDeviceId = server.arg("ha_id");
  mqttHost.trim();
  mqttUser.trim();
  haHost.trim();
  haName.trim();
  haDeviceId.trim();
  if (mqttHost.length() == 0) mqttHost = "homeassistant.local";
  if (haName.length() == 0) haName = "Jarvis Fan System";
  if (haDeviceId.length() == 0) haDeviceId = "jarvis_fan_system_final";

  if (server.hasArg("f_min")) fanMinSpeed = constrain(server.arg("f_min").toInt(), 1, 100);
  if (server.hasArg("f_max")) fanMaxSpeed = constrain(server.arg("f_max").toInt(), fanMinSpeed, 100);
  if (server.hasArg("f_start")) fanStartupSpeed = constrain(server.arg("f_start").toInt(), fanMinSpeed, fanMaxSpeed);

  if (server.hasArg("t_e")) tank_empty_dist = constrain(server.arg("t_e").toInt(), 2, 400);
  if (server.hasArg("t_f")) tank_full_dist = constrain(server.arg("t_f").toInt(), 1, 399);
  // Tank distance must decrease as the tank fills; reject an invalid pair.
  if (tank_empty_dist <= tank_full_dist) {
    tank_empty_dist = 110;
    tank_full_dist = 10;
  }

  if (server.hasArg("m_s")) motor_start_pct = constrain(server.arg("m_s").toInt(), 0, 99);
  if (server.hasArg("m_p")) motor_stop_pct = constrain(server.arg("m_p").toInt(), 1, 100);
  if (motor_stop_pct <= motor_start_pct) {
    motor_start_pct = 15;
    motor_stop_pct = 98;
  }

  for (int i = 0; i < 4; i++) {
    String key = "zc" + String(i);
    if (server.hasArg(key)) {
      int profile = server.arg(key).toInt();
      if (profile >= 0 && profile <= ZC_PROFILE_PC817_FALLING) zcProfile[i] = (uint8_t)profile;
    }
    String offKey = "zco" + String(i);
    if (server.hasArg(offKey)) {
      zcTimingOffsetUs[i] = constrain(server.arg(offKey).toInt(), -2000, 2000);
    }
  }

  savePreferences();
  applyZcInterrupts();
  for (int i = 0; i < 4; i++) {
    int currentSpeed = (int)fanSpeed[i];
    if (currentSpeed > fanMaxSpeed) setFanSpeed(i, fanMaxSpeed, true);
    else if (currentSpeed > 0 && currentSpeed < fanMinSpeed) setFanSpeed(i, fanMinSpeed, true);
  }

  client.disconnect();
  client.setServer(mqttHost.c_str(), mqttPort);
  if (mqttPass.length() >= 8) ArduinoOTA.setPassword(mqttPass.c_str());

  server.send(200, "text/html",
              "<html><body><h2>Saved.</h2><p>MQTT settings will reconnect automatically.</p>"
              "<a href='/'>Back</a></body></html>");
}

void startDashboardServer() {
  if (dashboardServerRunning || configPortalRunning || WiFi.status() != WL_CONNECTED) return;
  server.begin();
  dashboardServerRunning = true;
  Serial.print("[WEB][OK] Dashboard listening at http://");
  Serial.println(WiFi.localIP());
}

void stopDashboardServer() {
  if (!dashboardServerRunning) return;
  server.stop();
  dashboardServerRunning = false;
  Serial.println("[WEB] Dashboard server stopped to release TCP port 80 for WiFiManager.");
}

void setupWebServer() {
  server.on("/", HTTP_GET, handleDashboard);
  server.on("/api/status", HTTP_GET, handleStatusApi);
  server.on("/api/fan", HTTP_GET, handleFanApi);
  server.on("/save", HTTP_POST, handleSaveConfig);
  server.on("/wifi", HTTP_GET, handleWiFiPortal);

  // WiFiManager also owns TCP port 80 while its AP portal is active.
  // Never bind the dashboard server at the same time.
  startDashboardServer();
}

