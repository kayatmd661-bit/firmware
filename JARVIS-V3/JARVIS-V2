  wm_mqtt_pass = new WiFiManagerParameter("mqtt_pass", "MQTT Password (leave blank to keep current)", "", 64, "type='password' autocomplete='new-password'");
  wm_ha_host = new WiFiManagerParameter("ha_host", "Home Assistant Host/IP", haHost.c_str(), 64);
  wm_ha_port = new WiFiManagerParameter("ha_port", "Home Assistant Port", haPortBuf, 6);
  wm_ha_name = new WiFiManagerParameter("ha_name", "HA Device Name", haName.c_str(), 64);
  wm_ha_id = new WiFiManagerParameter("ha_id", "HA Device ID", haDeviceId.c_str(), 64);

  wm.addParameter(wm_mqtt_host);
  wm.addParameter(wm_mqtt_port);
  wm.addParameter(wm_mqtt_user);
