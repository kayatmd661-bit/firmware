// ========================= MQTT CALLBACK =============================

void callback(char* topic, byte* payload, unsigned int length) {
  String message;
  message.reserve(length + 1);

  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }

  message.trim();

  String topicStr = String(topic);

  for (int i = 0; i < 4; i++) {
    if (topicStr == "jarvis/" + fanUIDs[i] + "/speed/cmd") {
      bool numeric = message.length() > 0;
      for (unsigned int k = 0; k < message.length(); k++) {
        if (!isDigit(message[k])) { numeric = false; break; }
      }
      if (numeric) {
        int requestedSpeed = message.toInt();
        if (requestedSpeed >= 0 && requestedSpeed <= 100) setFanSpeed(i, requestedSpeed);
      }
    }
    else if (topicStr == "jarvis/" + fanUIDs[i] + "/cmd") {
      if (message == "ON") {
        setFanState(i, true);
      } else if (message == "OFF") {
        setFanState(i, false, true);
      }
    }
  }

  if (topicStr == "jarvis/motor/cmd") {
    bool state = (message == "ON");
    // Require a valid tank reading and prevent filling beyond the stop level.
    if (state && (motorRunTimeoutLatched || !waterLevelValid || millis() - lastWaterReadingAt > 15000UL ||
                  lastWater < 0 || lastWater >= motor_stop_pct)) {
      Serial.println("[MOTOR][BLOCKED] ON rejected: tank reading is invalid/stale or already at stop threshold.");
      state = false;
    }

    digitalWrite(MOTOR_PIN, state ? HIGH : LOW);
    if (state) motorRunStartedAt = millis();
    else motorRunStartedAt = 0;
    pref.putBool("m_st", state);
    lastMotorState = state;

    if (client.connected()) {
      client.publish(
        "jarvis/status/motor",
        state ? "ON" : "OFF",
        true
      );
    }
  }
  else if (topicStr == "jarvis/settings/empty/set") {
    int candidate = message.toInt();
    if (candidate >= 2 && candidate <= 400 && candidate > tank_full_dist) {
      tank_empty_dist = candidate;
      pref.putInt("t_e", tank_empty_dist);
    } else {
      Serial.println("[CONFIG][REJECT] Invalid tank-empty distance; existing setting retained.");
    }
  }
  else if (topicStr == "jarvis/settings/full/set") {
    int candidate = message.toInt();
    if (candidate >= 1 && candidate <= 399 && candidate < tank_empty_dist) {
      tank_full_dist = candidate;
      pref.putInt("t_f", tank_full_dist);
    } else {
      Serial.println("[CONFIG][REJECT] Invalid tank-full distance; existing setting retained.");
    }
  }
}

// ========================= MQTT =====================================

void subscribeTopics() {
  client.subscribe("jarvis/+/cmd");
  client.subscribe("jarvis/+/speed/cmd");
  client.subscribe("jarvis/motor/cmd");
  client.subscribe("jarvis/settings/+/set");
}

void restoreOutputs() {
  // Safety: never restart a water pump automatically after a reboot or
  // MQTT reconnection. The level-control task may start it after valid data.
  digitalWrite(MOTOR_PIN, LOW);
  motorRunStartedAt = 0;
  motorRunTimeoutLatched = false;
  lastMotorState = false;
  pref.putBool("m_st", false);

  for (int i = 0; i < 4; i++) {
    int saved = pref.getInt(
      (fanUIDs[i] + "_sp").c_str(),
      0
    );

    setFanSpeed(i, saved, false);
  }
}

bool connectMqttOnce() {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (client.connected()) return true;

  String clientId = "Jarvis_Final_2026_" + String((uint32_t)ESP.getEfuseMac(), HEX);

  bool ok = false;

  if (mqttUser.length() > 0) {
    ok = client.connect(
      clientId.c_str(),
      mqttUser.c_str(),
      mqttPass.c_str(),
      availability_topic,
      0,
      true,
      "offline"
    );
  } else {
    ok = client.connect(
      clientId.c_str(),
      availability_topic,
      0,
      true,
      "offline"
    );
  }

  if (ok) {
    client.publish(availability_topic, "online", true);
    subscribeTopics();
    sendDiscovery();
    // MQTT reconnect must not reload old fan values from NVS over live
    // dashboard commands. Keep current fan state; force only the pump OFF
    // as a reconnect safety policy, then publish the live states.
    digitalWrite(MOTOR_PIN, LOW);
    lastMotorState = false;
    pref.putBool("m_st", false);
    for (int i = 0; i < 4; i++) {
      client.publish(("jarvis/status/" + fanUIDs[i]).c_str(), fanEnabled[i] ? "ON" : "OFF", true);
      client.publish(("jarvis/status/" + fanUIDs[i] + "/speed").c_str(), String((int)fanSpeed[i]).c_str(), true);
    }
    if (lastTemp > -999) client.publish("jarvis/sensor/temp", String(lastTemp, 1).c_str(), true);
    if (lastHum > -999) client.publish("jarvis/sensor/hum", String(lastHum, 1).c_str(), true);
    if (lastWater >= 0) client.publish("jarvis/sensor/water_pct", String(lastWater, 0).c_str(), true);
    if (lastVolt >= 0) client.publish("jarvis/sensor/volt", String(lastVolt, 1).c_str(), true);
    if (lastCurrent >= 0) client.publish("jarvis/sensor/curr", String(lastCurrent, 2).c_str(), true);
    if (lastPower >= 0) client.publish("jarvis/sensor/pwr", String(lastPower, 1).c_str(), true);
    if (lastPressure > -999) client.publish("jarvis/sensor/pressure", String(lastPressure, 1).c_str(), true);
    client.publish("jarvis/sensor/pir", lastPir ? "ON" : "OFF", true);
    client.publish("jarvis/status/motor", lastMotorState ? "ON" : "OFF", true);
    zcStatePublishPending = true;
    lastDiscovery = millis();

    Serial.println("MQTT connected");
  } else {
    Serial.print("MQTT failed, state=");
    Serial.println(client.state());
  }

  return ok;
}

void mqttTask() {
  if (client.connected()) {
    client.loop();
    if (discoveryPublishFailed && millis() - lastDiscovery >= 60000UL) {
      lastDiscovery = millis();
      Serial.println("[MQTT][HA] Retrying incomplete Home Assistant discovery publish set.");
      sendDiscovery();
    }
    return;
  }

  if (millis() - lastMqttAttempt >= 5000) {
    lastMqttAttempt = millis();
    connectMqttOnce();
  }
}

