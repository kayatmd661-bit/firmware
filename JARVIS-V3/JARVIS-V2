  h += F("txt('pwr',x.pwr+' W');txt('pressure',x.pressure+' hPa');");
  h += F("txt('wifi',x.wifiConnected?'CONNECTED':'DISCONNECTED');");
  h += F("document.getElementById('wifi').className='value '+(x.wifiConnected?'ok':'bad');");
  h += F("txt('wifiSsid',x.wifiSsid||'--');txt('wifiIp',x.wifiIp||'--');");
  h += F("txt('mqtt',x.mqtt?'CONNECTED':'DISCONNECTED');");
  h += F("}).catch(()=>{});}");
  h += F("refresh();setInterval(refresh,2000);");
  h += F("</script></body></html>");

  return h;
}


bool authorizeDashboardRequest() {
  if (mqttPass.length() < 8) {
    server.send(503, "text/plain; charset=utf-8", "Dashboard disabled: configure an MQTT password of at least 8 characters.");
    return false;
  }
  const String authUser = mqttUser.length() ? mqttUser : String("jarvis");
  if (!server.authenticate(authUser.c_str(), mqttPass.c_str())) {
    server.requestAuthentication();
    return false;
  }
  return true;
}

void handleDashboard() {
  if (!authorizeDashboardRequest()) return;
  server.send(200, "text/html; charset=utf-8", buildDashboard());
}

void handleWiFiPortal() {
  if (!authorizeDashboardRequest()) return;
  server.send(200, "text/html; charset=utf-8",
              "<html><meta name='viewport' content='width=device-width,initial-scale=1'>"
              "<body><h2>Jarvis WiFi setup</h2><p>The setup portal is available only after physical factory reset. If available, connect to Jarvis_AP (password: JarvisSetup26), then open http://192.168.4.1.</p></body></html>");
