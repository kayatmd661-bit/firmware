void refreshWiFiManagerParameters() {
  if (!wifiPortalParametersAdded) return;
  char mqttPortBuf[8];
  char haPortBuf[8];
  snprintf(mqttPortBuf, sizeof(mqttPortBuf), "%u", mqttPort);
  snprintf(haPortBuf, sizeof(haPortBuf), "%u", haPort);
  if (wm_mqtt_host) wm_mqtt_host->setValue(mqttHost.c_str(), 64);
  if (wm_mqtt_port) wm_mqtt_port->setValue(mqttPortBuf, 6);
  if (wm_mqtt_user) wm_mqtt_user->setValue(mqttUser.c_str(), 64);
  if (wm_mqtt_pass) wm_mqtt_pass->setValue("", 64); // Never expose stored secrets in the portal HTML.
  if (wm_ha_host) wm_ha_host->setValue(haHost.c_str(), 64);
  if (wm_ha_port) wm_ha_port->setValue(haPortBuf, 6);
  if (wm_ha_name) wm_ha_name->setValue(haName.c_str(), 64);
  if (wm_ha_id) wm_ha_id->setValue(haDeviceId.c_str(), 64);
}

void startWiFiManagerPortal() {
  createWiFiManagerParameters();
  refreshWiFiManagerParameters();

  WiFi.persistent(true);
  WiFi.setAutoReconnect(false);
  WiFi.mode(WIFI_STA);
  WiFi.setMinSecurity(WIFI_AUTH_WPA_PSK);
  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
  WiFi.setSortMethod(WIFI_CONNECT_AP_BY_SIGNAL);
  Serial.println("[WiFi][SECURITY] Minimum auth threshold=WPA-PSK (WPA/WPA2 Personal accepted; OPEN/WEP rejected).");

  wm.setDebugOutput(false);
  wm.setCleanConnect(false);
  wm.setConnectTimeout(20);
  wm.setConnectRetries(3);
  wm.setSaveConnect(true);
  wm.setBreakAfterConfig(false);
  wm.setWiFiAutoReconnect(false);
  wm.setConfigPortalBlocking(false);
  wm.setPreSaveConfigCallback(wifiCredentialsSubmitCallback);
  wm.setSaveConfigCallback(saveConfigCallback);
  wm.setConfigPortalTimeout(0);

  String savedSsid = wm.getWiFiSSID(true);
  String savedPassword = wm.getWiFiPass(true);
  savedSsid.trim();
  if (savedSsid.length() > 0) {
    Serial.print("[WiFi][NVS][LOAD][OK] Saved SSID loaded: '");
    Serial.print(savedSsid);
    Serial.println("'. Password value hidden.");
    Serial.println("[WiFi][START] Connecting with saved credentials; setup portal LOCKED.");
    wifiDisconnectedSince = millis();
    lastWiFiReconnectAttempt = millis();
    wifiReconnectAttempts = 0;
    wifiGotIpEvent = false;
    WiFi.setMinSecurity(WIFI_AUTH_WPA_PSK);
    WiFi.begin(savedSsid.c_str(), savedPassword.c_str());
    Serial.println("[WiFi][START] STA connection initiated; DHCP result will be monitored asynchronously.");
  } else if (wifiEverConnected) {
    Serial.println("[WiFi][PORTAL][LOCKED] Provisioned device has no readable SSID. No automatic portal; physical BOOT factory reset required.");
    wifiDisconnectedSince = millis();
    lastWiFiReconnectAttempt = millis();
  } else {
    Serial.println("[WiFi][NVS][EMPTY] First-time setup/factory reset: opening secured Jarvis_AP.");
    bool started = wm.startConfigPortal("Jarvis_AP", "JarvisSetup26");
    configPortalRunning = wm.getConfigPortalActive();
    Serial.printf("[WiFi][PORTAL] startConfigPortal returned=%s active=%s\\n",
                  started ? "true" : "false", configPortalRunning ? "YES" : "NO");
    if (configPortalRunning) {
      Serial.print("[WiFi][PORTAL] AP IP: ");
      Serial.println(WiFi.softAPIP());
    }
  }
  client.setServer(mqttHost.c_str(), mqttPort);
}

void startWiFiPortalFromDashboard() {
  // This function is called only from wifiTask(), after the dashboard
  // request handler has returned and released its current HTTP transaction.
  if (configPortalRunning) return;
  if (wifiEverConnected || wm.getWiFiSSID(true).length() > 0) {
    Serial.println("[WiFi][PORTAL][BLOCKED] Provisioned/saved device. Portal is locked until physical factory reset.");
    return;
  }

  Serial.println("[WiFi][PORTAL] Starting first-time setup portal.");
  stopDashboardServer();
  refreshWiFiManagerParameters();
  WiFi.persistent(true);
  WiFi.setAutoReconnect(false);
  WiFi.mode(WIFI_STA);
  WiFi.setMinSecurity(WIFI_AUTH_WPA_PSK);
  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
  WiFi.setSortMethod(WIFI_CONNECT_AP_BY_SIGNAL);
  Serial.println("[WiFi][SECURITY] Portal STA threshold set to WPA-PSK.");
  wifiPortalManual = true;
  wm.setDebugOutput(false);
  wm.setCleanConnect(false);
  wm.setConnectTimeout(20);
  wm.setConnectRetries(3);
  wm.setSaveConnect(true);
  wm.setBreakAfterConfig(false);
  wm.setWiFiAutoReconnect(false);
  wm.setConfigPortalBlocking(false);
  wm.setPreSaveConfigCallback(wifiCredentialsSubmitCallback);
  wm.setSaveConfigCallback(saveConfigCallback);
  wm.setConfigPortalTimeout(0);

  bool started = wm.startConfigPortal("Jarvis_AP", "JarvisSetup26");
  configPortalRunning = wm.getConfigPortalActive();
  lastPortalStartAttempt = millis();
  Serial.print("[WiFi][PORTAL] startConfigPortal returned: ");
  Serial.println(started ? "true" : "false (non-blocking start may still be active)");
  Serial.print("[WiFi][PORTAL] Active: ");
  Serial.println(configPortalRunning ? "YES" : "NO");
  if (configPortalRunning) {
    Serial.print("[WiFi][PORTAL] AP IP: ");
    Serial.println(WiFi.softAPIP());
  }
}

void wifiTask() {
  if (wifiDisconnectEventPending) {
    wifiDisconnectEventPending = false;
    const uint8_t reason = wifiEventDisconnectReason;
    Serial.printf("[WiFi][ERROR] Disconnected reason=%u (%s)\n", reason, wifiDisconnectReasonText(reason));
    if (reason == 210 || reason == 211) Serial.println("[WiFi][HINT] Try 2.4GHz WPA2-Personal AES; WPA3-only/Enterprise is not supported by this profile.");
    else if (reason == 201) Serial.println("[WiFi][HINT] Check exact SSID, hidden network, 2.4GHz band and signal.");
  }
  if (wifiLostIpEventPending) {
    wifiLostIpEventPending = false;
    Serial.println("[WiFi][ERROR] DHCP/IP lost; treating link as disconnected.");
  }

  // A dashboard request only sets this flag. Stop its server and start
  // WiFiManager here, outside the WebServer request callback.
  if (wifiPortalStartRequested && !configPortalRunning) {
    wifiPortalStartRequested = false;
    startWiFiPortalFromDashboard();
  }

  if (configPortalRunning) {
    stopDashboardServer();
    wm.process();
    bool stillActive = wm.getConfigPortalActive();
    if (!stillActive) {
      Serial.println("[WiFi][PORTAL] Portal closed; releasing port 80.");
      configPortalRunning = false;
      wifiPortalManual = false;
      if (!wifiSaveCheckPending) wifiCredentialsSubmitted = false;
    }
  }

  if (wifiSaveCheckPending) {
    const bool hasValidIP = (WiFi.status() == WL_CONNECTED &&
                             wifiGotIpEvent &&
                             WiFi.localIP() != IPAddress(0, 0, 0, 0));

    if (hasValidIP) {
      const String connectedSSID = WiFi.SSID();
      const String storedSSID = wm.getWiFiSSID(true);
      const String storedPassword = wm.getWiFiPass(true);

      if (connectedSSID.length() > 0 && connectedSSID == storedSSID) {
        if (!wifiEverConnected) {
          wifiEverConnected = true;
          pref.putBool("wifi_ok", true);
          Serial.println("[WiFi][NVS][OK] First successful IP saved; portal now locked until physical factory reset.");
        }
        // WiFiManager has authenticated the submitted password and the STA
        // has received an IP. Only now persist the other portal parameters.
        captureWiFiManagerParameters();
        savePreferences();
        client.disconnect();
        client.setServer(mqttHost.c_str(), mqttPort);

        wifiSaveCheckPending = false;
        wifiCredentialsSubmitted = false;
        wifiPortalManual = false;
        wifiDisconnectedSince = 0;
        wifiReconnectAttempts = 0;
        lastWiFiReconnectAttempt = 0;

        Serial.print("[WiFi][VERIFY][OK] Connected SSID verified: '");
        Serial.print(connectedSSID);
        Serial.println("'");
        Serial.print("[WiFi][VERIFY][OK] Saved password present: ");
        Serial.println(storedPassword.length() > 0 ? "YES (value hidden)" : "NO / OPEN NETWORK");
        Serial.println("[WiFi][SAVE][OK] New WiFi credentials are authenticated and stored by ESP32 WiFi NVS.");
        Serial.println("[NVS][SAVE][OK] MQTT/HA portal parameters saved after WiFi verification.");
      } else if (millis() - wifiSaveCheckAt >= WIFI_SAVE_VERIFY_TIMEOUT_MS) {
        wifiSaveCheckPending = false;
        wifiCredentialsSubmitted = false;
        Serial.println("[WiFi][VERIFY][FAIL] Connected SSID does not match WiFiManager's saved SSID. Application settings were not committed.");
        wifiPortalManual = false;
        wifiDisconnectedSince = millis();
        lastWiFiReconnectAttempt = millis();
        Serial.println("[WiFi][RETRY] Saved credentials retained; portal remains locked.");
      }
    } else if (millis() - wifiSaveCheckAt >= WIFI_SAVE_VERIFY_TIMEOUT_MS) {
      wifiSaveCheckPending = false;
      wifiCredentialsSubmitted = false;
      Serial.println("[WiFi][VERIFY][FAIL] No valid DHCP/IP connection after WiFiManager save callback. Application settings were not committed.");
      wifiPortalManual = false;
      wifiDisconnectedSince = millis();
      lastWiFiReconnectAttempt = millis();
      Serial.println("[WiFi][RETRY] Saved credentials retained; portal remains locked.");
    }
  }

  const bool hasUsableIP = (WiFi.status() == WL_CONNECTED && wifiGotIpEvent &&
                            WiFi.localIP() != IPAddress(0, 0, 0, 0));
  if (hasUsableIP) {
    if (!wifiEverConnected) {
      wifiEverConnected = true;
      pref.putBool("wifi_ok", true);
      Serial.println("[WiFi][NVS][OK] First successful IP saved; portal locked until physical factory reset.");
    }
    wifiDisconnectedSince = 0;
    wifiReconnectAttempts = 0;
    lastWiFiReconnectAttempt = 0;
    if (configPortalRunning && !wifiPortalManual &&
        !wifiCredentialsSubmitted && !wifiSaveCheckPending) {
      wm.stopConfigPortal();
      configPortalRunning = false;
    }
    if (!configPortalRunning) startDashboardServer();
    if (!otaStarted) setupOTA();
    return;
  }

  if (configPortalRunning) return; // WiFiManager exclusively owns STA while portal is active.

  if (wifiDisconnectedSince == 0) {
    wifiDisconnectedSince = millis();
    lastWiFiReconnectAttempt = millis();
    wifiReconnectAttempts = 0;
  }

  // Saved credentials are never discarded and provisioning is never opened
  // because a router is offline or authentication/DHCP temporarily fails.
  // Retry forever at a fixed interval until GOT_IP is received.
  if (millis() - lastWiFiReconnectAttempt >= WIFI_RECONNECT_INTERVAL_MS) {
    lastWiFiReconnectAttempt = millis();
    if (wifiReconnectAttempts < 255) wifiReconnectAttempts++;
    Serial.print("[WiFi][RETRY] Saved-profile reconnect attempt #");
    Serial.println(wifiReconnectAttempts);
    String ssid = wm.getWiFiSSID(true);
    String password = wm.getWiFiPass(true);
    if (ssid.length() > 0) {
      WiFi.disconnect(false, false);
      WiFi.setMinSecurity(WIFI_AUTH_WPA_PSK);
      WiFi.begin(ssid.c_str(), password.c_str());
    } else {
      Serial.println("[WiFi][ERROR] No saved SSID found; portal remains locked unless factory reset is performed.");
    }
    return;
  }
}

// ========================= OTA ======================================

void setupOTA() {
  if (otaStarted) return;
  ArduinoOTA.setHostname("jarvis-fan-system");
  const char *otaPassword = (mqttPass.length() >= 8) ? mqttPass.c_str() : "JarvisOTA-ChangeMe";
  ArduinoOTA.setPassword(otaPassword);
  Serial.println("[OTA][SECURITY] OTA password authentication enabled; change default MQTT/OTA credentials after setup.");

  ArduinoOTA.onStart([]() {
    // Stop moving/high-current loads before flash erase/write begins.
    digitalWrite(MOTOR_PIN, LOW);
    lastMotorState = false;
    pref.putBool("m_st", false);
    for (int i = 0; i < 4; i++) {
      applyFanHardware(i, 0);
    }
  });

  ArduinoOTA.begin();
  otaStarted = true;
  Serial.println("[OTA][OK] OTA service started after Wi-Fi received a valid IP.");
}

