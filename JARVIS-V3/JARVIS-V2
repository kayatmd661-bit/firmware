// Read back the REAL ESP-IDF STA configuration. This proves which security
// threshold is actually applied when the driver rejects an access point.
void printStaSecurityConfig(const char* stage) {
  wifi_config_t cfg = {};
  esp_err_t err = esp_wifi_get_config(WIFI_IF_STA, &cfg);
  Serial.print("[WiFi][STA-CONFIG][");
  Serial.print(stage);
  Serial.print("] esp_wifi_get_config result=");
  Serial.println((int)err);
  if (err == ESP_OK) {
    Serial.print("[WiFi][STA-CONFIG] auth threshold=");
    Serial.print(wifiAuthModeText(cfg.sta.threshold.authmode));
    Serial.print(" (");
    Serial.print((int)cfg.sta.threshold.authmode);
    Serial.println(")");
    Serial.print("[WiFi][STA-CONFIG] password length=");
    Serial.println(strlen((const char*)cfg.sta.password));
    Serial.print("[WiFi][STA-CONFIG] target SSID='");
    Serial.print((const char*)cfg.sta.ssid);
    Serial.println("'");
  }
}

void printWiFiScanDiagnostics() {
  Serial.println("[WiFi][SCAN] Starting 2.4 GHz network scan (passwords are never printed)...");
  int count = WiFi.scanNetworks(false, true); // include hidden SSIDs
  if (count < 0) {
    Serial.print("[WiFi][SCAN][ERROR] Scan failed, code: ");
    Serial.println(count);
    return;
  }
  Serial.print("[WiFi][SCAN] Networks found: ");
  Serial.println(count);
  String savedSsid = wm.getWiFiSSID(true);
  Serial.print("[WiFi][SCAN] Saved SSID: '");
  Serial.print(savedSsid);
  Serial.println("'");
  bool savedFound = false;
  for (int i = 0; i < count; ++i) {
    String foundSsid = WiFi.SSID(i);
    bool match = (foundSsid == savedSsid);
    if (match) savedFound = true;
    Serial.print("[WiFi][SCAN] ");
    Serial.print(i + 1);
    Serial.print(" SSID='"); Serial.print(foundSsid); Serial.print("' RSSI=");
    Serial.print(WiFi.RSSI(i)); Serial.print("dBm CH=");
    Serial.print(WiFi.channel(i)); Serial.print(" AUTH=");
    wifi_auth_mode_t auth = WiFi.encryptionType(i);
    Serial.print(wifiAuthModeText(auth));
    Serial.print(" ("); Serial.print((int)auth); Serial.print(")");
    if (match) Serial.print("  <== SAVED SSID MATCH");
    Serial.println();
  }
  if (savedSsid.length() == 0) {
    Serial.println("[WiFi][SCAN][INFO] No saved SSID. Select your 2.4 GHz WiFi in Jarvis_AP portal.");
  } else if (!savedFound) {
    Serial.println("[WiFi][SCAN][ERROR] Saved SSID NOT FOUND. Check spelling, 2.4 GHz band, hidden SSID and router signal.");
  } else {
    Serial.println("[WiFi][SCAN][OK] Saved SSID is visible. If connect fails next, inspect AUTH mode and disconnect reason.");
  }
  WiFi.scanDelete();
}

void onWiFiEvent(WiFiEvent_t event, WiFiEventInfo_t info) {
  // Keep Wi-Fi callbacks short; diagnostics and reconnection run in wifiTask().
  switch (event) {
    case ARDUINO_EVENT_WIFI_STA_GOT_IP:
      wifiGotIpEvent = true;
      break;
    case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
      wifiGotIpEvent = false;
      wifiEventDisconnectReason = info.wifi_sta_disconnected.reason;
      wifiDisconnectEventPending = true;
      break;
    case ARDUINO_EVENT_WIFI_STA_LOST_IP:
      wifiGotIpEvent = false;
      wifiLostIpEventPending = true;
      break;
    default:
      break;
  }
}

void serviceStatusLed() {
  // Wi-Fi indication is deliberately independent of MQTT availability.
  // A valid STA IP means the router connection succeeded, even if the broker is offline.
  const bool wifiConnected = (WiFi.status() == WL_CONNECTED &&
                              WiFi.localIP() != IPAddress(0, 0, 0, 0));
  if (wifiConnected) {
    statusLedState = true;
    digitalWrite(STATUS_LED_PIN, HIGH);
    return;
  }
  if (millis() - lastStatusLedToggle >= 500UL) {
    lastStatusLedToggle = millis();
    statusLedState = !statusLedState;
    digitalWrite(STATUS_LED_PIN, statusLedState ? HIGH : LOW);
  }
}

void serviceConnectionDiagnostics() {
  static int lastWiFiState = -1;
  static int lastMqttState = -1;
  const bool wifiConnected = (WiFi.status() == WL_CONNECTED &&
                              WiFi.localIP() != IPAddress(0, 0, 0, 0));
  const int wifiState = wifiConnected ? 1 : 0;
  if (wifiState != lastWiFiState) {
    lastWiFiState = wifiState;
    if (wifiConnected) {
      Serial.println("[WiFi][STATUS] CONNECTED to router");
      Serial.printf("[WiFi][STATUS] SSID='%s'\n", WiFi.SSID().c_str());
      Serial.printf("[WiFi][STATUS] IP=%s  RSSI=%d dBm  CHANNEL=%d\n",
                    WiFi.localIP().toString().c_str(), WiFi.RSSI(), WiFi.channel());
      Serial.println("[WiFi][STATUS] STATUS LED GPIO2 = SOLID ON (MQTT state does not affect this LED)");
    } else {
      Serial.println("[WiFi][STATUS] DISCONNECTED from router; saved credentials retry is active");
      Serial.println("[WiFi][STATUS] STATUS LED GPIO2 = BLINKING");
    }
  }
  const int mqttState = client.connected() ? 1 : 0;
  if (mqttState != lastMqttState) {
    lastMqttState = mqttState;
    Serial.printf("[MQTT][STATUS] %s\n", mqttState ? "CONNECTED to broker" : "DISCONNECTED / retrying broker");
  }
}

// Change this ID whenever a firmware release must start from a clean setup.
// Only this marker is inspected; old WiFi/application configuration is never loaded
// before the one-time erase. Normal reboots retain the newly entered settings.
#define JARVIS_FIRMWARE_ID "JARVIS_AC_FAN_WATER_SAFE_2026_11_19_R6"

bool eraseEntireNvsPartition(const char* reason) {
  Serial.println();
  Serial.print("[NVS][ERASE] Starting complete NVS erase: ");
  Serial.println(reason);

  esp_err_t deinitResult = nvs_flash_deinit();
  if (deinitResult != ESP_OK && deinitResult != ESP_ERR_NVS_NOT_INITIALIZED) {
    Serial.print("[NVS][ERROR] nvs_flash_deinit failed: ");
    Serial.println((int)deinitResult);
    return false;
  }

  esp_err_t eraseResult = nvs_flash_erase();
  if (eraseResult != ESP_OK) {
    Serial.print("[NVS][ERROR] nvs_flash_erase failed: ");
    Serial.println((int)eraseResult);
    nvs_flash_init();
    return false;
  }

  esp_err_t initResult = nvs_flash_init();
  if (initResult != ESP_OK) {
    Serial.print("[NVS][ERROR] nvs_flash_init after erase failed: ");
    Serial.println((int)initResult);
    return false;
  }

  Serial.println("[NVS][ERASE][OK] Complete NVS partition erased and reinitialized.");
  return true;
}

bool prepareFreshSetupForFirmwareVersion() {
  // Firmware upgrades are NEVER allowed to erase the complete NVS partition.
  // Only performFactoryReset(), invoked by the physical BOOT hold, may erase it.
  Preferences markerPref;
  if (!markerPref.begin("jarvis_sys", false)) {
    Serial.println("[NVS][WARN] Firmware marker unavailable; preserving all existing settings.");
    return true;
  }
  const String oldId = markerPref.getString("fw_id", "");
  if (oldId != JARVIS_FIRMWARE_ID) {
    markerPref.putString("fw_id", JARVIS_FIRMWARE_ID);
    Serial.println("[NVS][MIGRATION] Firmware marker updated; all existing WiFi/JARVIS settings preserved.");
  } else {
    Serial.println("[NVS][BOOT] Firmware marker matches; saved settings preserved.");
  }
  markerPref.end();
  return true;
}

// ========================= FACTORY RESET =============================

void performFactoryReset() {
  if (factoryResetExecuting) return;
  factoryResetExecuting = true;

  Serial.println();
  Serial.println("[RESET] FACTORY RESET STARTED");
  Serial.println("[RESET] Stopping motor and all fan TRIAC outputs...");
  digitalWrite(MOTOR_PIN, LOW);
  for (int i = 0; i < 4; i++) {
    applyFanHardware(i, 0);
    fanEnabled[i] = false;
    fanSpeed[i] = 0;
  }

  Serial.println("[RESET] Stopping network services and clearing WiFi driver credentials...");
  stopDashboardServer();
  wm.stopConfigPortal();
  WiFi.persistent(true);
  wm.resetSettings();
  WiFi.disconnect(true, true);
  pref.end();

  if (!eraseEntireNvsPartition("user requested physical BOOT-button factory reset")) {
    Serial.println("[RESET][FATAL] NVS erase failed; controller will restart but old data may remain.");
  } else {
    Serial.println("[RESET][OK] WiFi credentials and all JARVIS NVS settings erased.");
    Preferences resetMarker;
    if (resetMarker.begin("jarvis_sys", false)) {
      resetMarker.putString("fw_id", JARVIS_FIRMWARE_ID);
      resetMarker.end();
      Serial.println("[RESET][OK] Firmware marker restored; next boot will NOT erase again.");
    } else {
      Serial.println("[RESET][WARN] Could not restore firmware marker; first-boot setup may repeat once.");
    }
  }
  Serial.println("[RESET] Restarting into fresh Jarvis_AP WiFi setup...");
  delay(500);
  ESP.restart();
}

void serviceFactoryReset() {
  if (factoryResetExecuting) return;

  if (factoryResetRequested) {
    if (millis() - factoryResetRequestAt >= 1200UL) performFactoryReset();
    return;
  }

  // Hold the board BOOT button (GPIO0) continuously for 8 seconds after the ESP32 has finished booting.
  if (digitalRead(FACTORY_RESET_PIN) == LOW) {
    if (factoryResetButtonPressedAt == 0) {
      factoryResetButtonPressedAt = millis();
      Serial.println("[RESET] BOOT button held. Keep holding for 8 seconds to factory reset.");
    } else if (millis() - factoryResetButtonPressedAt >= 8000UL) {
      Serial.println("[RESET] 8-second BOOT hold confirmed.");
      performFactoryReset();
    }
  } else {
    factoryResetButtonPressedAt = 0;
  }
}

