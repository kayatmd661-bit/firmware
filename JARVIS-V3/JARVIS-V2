const char* resetReasonText(esp_reset_reason_t reason) {
  switch (reason) {
    case ESP_RST_POWERON: return "POWER_ON";
    case ESP_RST_EXT: return "EXTERNAL_RESET";
    case ESP_RST_SW: return "SOFTWARE_RESET";
    case ESP_RST_PANIC: return "PANIC/GURU_MEDITATION";
    case ESP_RST_INT_WDT: return "INTERRUPT_WATCHDOG";
    case ESP_RST_TASK_WDT: return "TASK_WATCHDOG";
    case ESP_RST_WDT: return "OTHER_WATCHDOG";
    case ESP_RST_DEEPSLEEP: return "DEEP_SLEEP_WAKE";
    case ESP_RST_BROWNOUT: return "BROWNOUT/LOW_SUPPLY";
    case ESP_RST_SDIO: return "SDIO_RESET";
    default: return "UNKNOWN_RESET";
  }
}

// ========================= SETUP ====================================

void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println();
  const esp_reset_reason_t bootResetReason = esp_reset_reason();
  Serial.printf("[RESET][CAUSE] code=%d name=%s\n", (int)bootResetReason, resetReasonText(bootResetReason));
  Serial.println("[BOOT] JARVIS AC FAN + WATER CONTROLLER v2026.11 R6 starting...");
  Serial.println("[BOOT] Serial diagnostics enabled at 115200 baud.");

  pinMode(STATUS_LED_PIN, OUTPUT);
  digitalWrite(STATUS_LED_PIN, LOW);
  pinMode(FACTORY_RESET_PIN, INPUT_PULLUP);
  WiFi.onEvent(onWiFiEvent);

  Serial2.begin(
    9600,
    SERIAL_8N1,
    PZEM_RX_PIN,
    PZEM_TX_PIN
  );

  // Outputs must start OFF before the rest of the system comes online.
  pinMode(FAN1_TRIAC_PIN, OUTPUT);
  pinMode(FAN2_TRIAC_PIN, OUTPUT);
  pinMode(FAN3_TRIAC_PIN, OUTPUT);
  pinMode(FAN4_TRIAC_PIN, OUTPUT);

  digitalWrite(FAN1_TRIAC_PIN, LOW);
  digitalWrite(FAN2_TRIAC_PIN, LOW);
  digitalWrite(FAN3_TRIAC_PIN, LOW);
  digitalWrite(FAN4_TRIAC_PIN, LOW);

  configureZcInput(0);
  configureZcInput(1);
  configureZcInput(2);
  configureZcInput(3);

  pinMode(PIRPIN, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(MOTOR_PIN, OUTPUT);

  digitalWrite(MOTOR_PIN, LOW);

  // Firmware changes preserve NVS. Only the physical factory-reset handler
  // is permitted to erase saved WiFi and application settings.
  const bool nvsReadyForThisFirmware = prepareFreshSetupForFirmwareVersion();
  if (nvsReadyForThisFirmware && pref.begin("jarvis_sys", false)) {
    loadPreferences();
    Serial.println("[NVS][LOAD][OK] Current firmware settings loaded.");
  } else {
    Serial.println("[NVS][LOAD][SKIP] Preferences unavailable; old application settings will not be loaded.");
  }

  dht.begin();

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);

  Serial.println("[BMP] Scanning I2C addresses 0x76 and 0x77...");
  if (bmp.begin(0x76)) {
    bmpAvailable = true;
    Serial.println("[BMP][OK] BMP280 detected at 0x76.");
  } else if (bmp.begin(0x77)) {
    bmpAvailable = true;
    Serial.println("[BMP][OK] BMP280 detected at 0x77.");
  } else {
    bmpAvailable = false;
    Serial.println("[BMP][ERROR] No BMP280 response at 0x76 or 0x77.");
    Serial.println("[BMP][CHECK] Check 3.3V, GND, SDA=GPIO21, SCL=GPIO22, wiring and sensor type.");
  }

  // ESP32 Arduino 3.x timer API. A 50 us tick limits scheduler ISR rate
  // to 20 kHz; GPIO writes in the ISR use direct registers.
  triacTimer = timerBegin(1000000);
  if (triacTimer) {
    timerAttachInterrupt(triacTimer, &triacTimerISR);
    timerAlarm(triacTimer, TRIAC_TIMER_TICK_US, true, 0);
    triacTimerReady = true;
    Serial.println("[TRIAC][OK] 50 us hardware scheduler started.");
  } else {
    triacTimerReady = false;
    Serial.println("[TRIAC][FATAL] Timer init failed; fan outputs will remain disabled.");
  }

  applyZcInterrupts();

  // WiFi first: saved credentials connect directly; only an empty NVS profile
  // (fresh install or physical factory reset) is allowed to start the portal.
  WiFi.mode(WIFI_STA);
  startWiFiManagerPortal();

  client.setServer(mqttHost.c_str(), mqttPort);
  client.setCallback(callback);
  client.setBufferSize(2048);
  client.setSocketTimeout(2);
  client.setKeepAlive(30);

  setupWebServer();

  // Initialize stored output states without publishing before MQTT.
  restoreOutputs();

  // Keep the ESP32 framework's idle-task watchdog, but do NOT subscribe the
  // Arduino loopTask to the short task watchdog. This loop performs synchronous
  // sensor and network-library calls; a 5-second loopTask timeout can reboot
  // the board even when the hardware is healthy. Idle-task WDT still detects
  // a CPU that is genuinely starved.
  esp_err_t loopWdtStatus = esp_task_wdt_status(NULL);
  Serial.printf("[WDT][INFO] loopTask subscription status=%d; custom loopTask subscription disabled; framework idle watchdog retained.\n",
                (int)loopWdtStatus);

  Serial.println();
  Serial.println("======================================");
  Serial.println("JARVIS AC FAN SYSTEM READY");
  Serial.println("Phase-angle TRIAC control enabled");
  Serial.println("STATUS LED: GPIO2 (SOLID ON = Wi-Fi connected with valid IP; BLINK = Wi-Fi disconnected)");
  Serial.println("FACTORY RESET: hold BOOT/GPIO0 continuously for 8 seconds after startup (physical button only).");
  Serial.print("WiFi status: ");
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("CONNECTED SSID='"); Serial.print(WiFi.SSID());
    Serial.print("' IP="); Serial.println(WiFi.localIP());
  } else if (configPortalRunning) {
    Serial.println("SETUP PORTAL ACTIVE (first setup / physical factory reset only)");
  } else {
    Serial.println("STA DISCONNECTED; SAVED CREDENTIAL RETRY ACTIVE; PORTAL LOCKED");
  }
  Serial.println("ZC profiles:");
  for (int i = 0; i < 4; i++) {
    Serial.print("  FAN");
    Serial.print(i + 1);
    Serial.print(": ");
    Serial.print(zcProfileName(zcProfile[i]));
    Serial.print("  offset=");
    Serial.print(zcTimingOffsetUs[i]);
    Serial.println("us");
  }
  Serial.print("Auto mains timing: ");
  Serial.println(AUTO_MEASURE_MAINS_FREQUENCY ? "YES" : "NO");
  Serial.println("======================================");
}

// ========================= LOOP =====================================

void publishZeroCrossStates() {
  if (!client.connected()) return;

  static bool lastZcState[4] = {false, false, false, false};
  if (zcStatePublishPending) {
    for (int i = 0; i < 4; i++) {
      bool state = fanZeroCrossHealthy(i);
      client.publish(
        ("jarvis/status/" + fanUIDs[i] + "/zc").c_str(),
        state ? "OK" : "FAULT",
        true
      );
      lastZcState[i] = state;
    }
    zcStatePublishPending = false;
    return;
  }

  for (int i = 0; i < 4; i++) {
    bool state = fanZeroCrossHealthy(i);

    if (state != lastZcState[i]) {
      client.publish(
        ("jarvis/status/" + fanUIDs[i] + "/zc").c_str(),
        state ? "OK" : "FAULT",
        true
      );

      lastZcState[i] = state;
    }
  }
}

void sensorTask() {
  if (digitalRead(MOTOR_PIN) == HIGH && motorRunStartedAt != 0 &&
      millis() - motorRunStartedAt >= MOTOR_MAX_CONTINUOUS_RUN_MS) {
    digitalWrite(MOTOR_PIN, LOW);
    motorRunStartedAt = 0;
    motorRunTimeoutLatched = true;
    pref.putBool("m_st", false);
    lastMotorState = false;
    if (client.connected()) client.publish("jarvis/status/motor", "OFF", true);
    Serial.println("[MOTOR][SAFETY] Maximum continuous runtime reached; pump forced OFF and restart latched until tank reaches stop threshold.");
  }
  if (millis() - lastSensorRead < 5000) return;

  lastSensorRead = millis();

  long dist = getDistance();

  // A missing/invalid echo must never be interpreted as a full tank.
  // Keep the pump OFF until a valid water-level reading is available.
  if (dist < 2 || dist > 400) {
    waterLevelValid = false;
    // Invalid water-level data is fail-safe for the pump, but must not
    // prevent temperature, power, PIR and pressure sensors from updating.
    if (digitalRead(MOTOR_PIN) == HIGH) {
      digitalWrite(MOTOR_PIN, LOW);
      motorRunStartedAt = 0;
      pref.putBool("m_st", false);
      lastMotorState = false;
      if (client.connected()) client.publish("jarvis/status/motor", "OFF", true);
    }
  } else {
    waterLevelValid = true;
    lastWaterReadingAt = millis();
    if (tank_empty_dist <= tank_full_dist) {
      tank_empty_dist = 110;
      tank_full_dist = 10;
    }

    int pct = constrain(map(dist, tank_empty_dist, tank_full_dist, 0, 100), 0, 100);

    if (abs(pct - lastWater) >= 1) {
      lastWater = pct;
      if (client.connected()) client.publish("jarvis/sensor/water_pct", String(pct).c_str(), true);
    }

    // Automatic hysteresis: start at/below low threshold; stop at/above high threshold.
    if (pct >= motor_stop_pct) motorRunTimeoutLatched = false;
    if (pct >= motor_stop_pct && digitalRead(MOTOR_PIN) == HIGH) {
      digitalWrite(MOTOR_PIN, LOW);
      motorRunStartedAt = 0;
      pref.putBool("m_st", false);
      lastMotorState = false;
      if (client.connected()) client.publish("jarvis/status/motor", "OFF", true);
    }
    else if (pct <= motor_start_pct && digitalRead(MOTOR_PIN) == LOW && !motorRunTimeoutLatched) {
      digitalWrite(MOTOR_PIN, HIGH);
      motorRunStartedAt = millis();
      pref.putBool("m_st", true);
      lastMotorState = true;
      if (client.connected()) client.publish("jarvis/status/motor", "ON", true);
    }
  }

  float v = pzem.voltage();

  if (!isnan(v)) {
    float c = pzem.current();
    float p = pzem.power();

    if (abs(v - lastVolt) > 0.5) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/volt",
          String(v, 1).c_str(),
          true
        );
      }
      lastVolt = v;
    }

    if (!isnan(c)) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/curr",
          String(c, 2).c_str(),
          true
        );
      }
      lastCurrent = c;
    }

    if (!isnan(p)) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/pwr",
          String(p, 1).c_str(),
          true
        );
      }
      lastPower = p;
    }
  }

  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t)) {
    if (abs(t - lastTemp) > 0.2) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/temp",
          String(t, 1).c_str(),
          true
        );
      }
      lastTemp = t;
    }
  }

  if (!isnan(h)) {
    if (abs(h - lastHum) > 0.5) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/hum",
          String(h, 1).c_str(),
          true
        );
      }
      lastHum = h;
    }
  }

  bool pir = digitalRead(PIRPIN);

  if (pir != lastPir) {
    if (client.connected()) {
      client.publish(
        "jarvis/sensor/pir",
        pir ? "ON" : "OFF",
        true
      );
    }

    lastPir = pir;
  }

  if (bmpAvailable) {
    float pressure = bmp.readPressure() / 100.0F;

    if (!isnan(pressure) && abs(pressure - lastPressure) > 0.5) {
      if (client.connected()) {
        client.publish(
          "jarvis/sensor/pressure",
          String(pressure, 1).c_str(),
          true
        );
      }

      lastPressure = pressure;
    }
  }
}

void loop() {
  // loopTask is intentionally not subscribed to task WDT; do not call
  // esp_task_wdt_reset() here. Calling it for an unregistered task causes
  // repeated "task not found" diagnostics on ESP32 Arduino.
  serviceFactoryReset();
  serviceStatusLed();
  serviceConnectionDiagnostics();

  // Handle a pending dashboard /wifi request before changing HTTP servers.
  if (dashboardServerRunning) server.handleClient();
  wifiTask();

  if (otaStarted) ArduinoOTA.handle();
  mqttTask();
  serviceFanPersistence();

  publishZeroCrossStates();

  sensorTask();

  delay(1);
}
