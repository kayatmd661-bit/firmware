String htmlEscape(const String &s) {
  String r;
  r.reserve(s.length() + 16);
  for (size_t i = 0; i < s.length(); i++) {
    switch (s[i]) {
      case '&': r += F("&amp;"); break;
      case '<': r += F("&lt;"); break;
      case '>': r += F("&gt;"); break;
      case '"': r += F("&quot;"); break;
      case '\'': r += F("&#39;"); break;
      default: r += s[i]; break;
    }
  }
  return r;
}

bool parsePort(const String &value, uint16_t &out) {
  if (value.length() == 0) return false;
  unsigned long parsed = 0;
  for (size_t i = 0; i < value.length(); i++) {
    char c = value[i];
    if (c < '0' || c > '9') return false;
    parsed = parsed * 10UL + (unsigned long)(c - '0');
    if (parsed > 65535UL) return false;
  }
  if (parsed < 1UL) return false;
  out = (uint16_t)parsed;
  return true;
}

unsigned long secondsToMs(uint16_t seconds) {
  unsigned long ms = (unsigned long)seconds * 1000UL;
  if (ms < 1000UL) ms = 1000UL;
  if (ms > MAX_MOTOR_TIME_MS) ms = MAX_MOTOR_TIME_MS;
  return ms;
}

String motorText(MotorAction state) {
