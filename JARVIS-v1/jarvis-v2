bool authorizeDashboardRequest() {
  String authUser = mqttUser.length() ? mqttUser : String("jarvis");
  if (mqttPass.length() < 8) {
    server.send(503, "text/plain; charset=utf-8",
                "Dashboard disabled: configure an MQTT password of at least 8 characters first.");
    return false;
  }
  if (!server.authenticate(authUser.c_str(), mqttPass.c_str())) {
    server.requestAuthentication();
    return false;
  }
  return true;
}

void handleDashboard() {
  if (!authorizeDashboardRequest()) return;
  server.send(200, "text/html; charset=utf-8", dashboardHtml());
}

void handleSave() {
  if (!authorizeDashboardRequest()) return;
  String requestedSsid = server.hasArg("wifi_ssid") ? server.arg("wifi_ssid") : wifiSsid;
  String submittedPass = server.hasArg("wifi_pass") ? server.arg("wifi_pass") : "";
  bool wifiChanged = false;

  if (requestedSsid.length() == 0) {
    server.send(400, "text/html; charset=utf-8",
                "<html><body><h2>Wi-Fi SSID ফাঁকা রাখা যাবে না।</h2><a href='/'>Back</a></body></html>");
    return;
  }

  if (requestedSsid != wifiSsid) {
    // A blank password is allowed for an open network.
    wifiChanged = true;
    requestedWifiSsid = requestedSsid;
    requestedWifiPassword = submittedPass;
  } else if (server.hasArg("wifi_pass") && submittedPass.length() > 0 && submittedPass != wifiPassword) {
    // Same SSID + a different password is a credential change.
    wifiChanged = true;
    requestedWifiSsid = requestedSsid;
    requestedWifiPassword = submittedPass;
  }

  const String oldWifiSsid = wifiSsid;
  const String oldWifiPassword = wifiPassword;
  const String oldMqttServer = mqttServer;
  const uint16_t oldMqttPort = mqttPort;
  const String oldMqttUser = mqttUser;
  const String oldMqttPass = mqttPass;
  const String oldHaHost = haHost;
  const uint16_t oldHaPort = haPort;
  const String oldHaCode = haCode;
  unsigned long oldOpenTimes[7];
  unsigned long oldCloseTimes[7];
  for (int i = 0; i < 7; i++) { oldOpenTimes[i] = motorOpenTime[i]; oldCloseTimes[i] = motorCloseTime[i]; }
  if (wifiChanged) {
    wifiSsid = requestedWifiSsid;
    wifiPassword = requestedWifiPassword;
  }

  if (server.hasArg("mqtt_host")) mqttServer = server.arg("mqtt_host");
  if (server.hasArg("mqtt_port")) parsePort(server.arg("mqtt_port"), mqttPort);
  if (server.hasArg("mqtt_user")) mqttUser = server.arg("mqtt_user");
  if (server.hasArg("mqtt_pass") && server.arg("mqtt_pass").length() > 0) mqttPass = server.arg("mqtt_pass");
  if (server.hasArg("ha_host")) haHost = server.arg("ha_host");
  if (server.hasArg("ha_port")) parsePort(server.arg("ha_port"), haPort);
  if (server.hasArg("ha_code")) haCode = server.arg("ha_code");

  for (int i = 0; i < 7; i++) {
    String opName = "op" + String(i);
    String clName = "cl" + String(i);
    if (server.hasArg(opName)) {
      uint16_t sec;
      if (parsePort(server.arg(opName), sec)) motorOpenTime[i] = secondsToMs(sec);
    }
    if (server.hasArg(clName)) {
      uint16_t sec;
      if (parsePort(server.arg(clName), sec)) motorCloseTime[i] = secondsToMs(sec);
    }
  }

  if (!saveNetworkConfig()) {
    wifiSsid = oldWifiSsid;
    wifiPassword = oldWifiPassword;
    mqttServer = oldMqttServer;
    mqttPort = oldMqttPort;
    mqttUser = oldMqttUser;
    mqttPass = oldMqttPass;
    haHost = oldHaHost;
    haPort = oldHaPort;
    haCode = oldHaCode;
    for (int i = 0; i < 7; i++) { motorOpenTime[i] = oldOpenTimes[i]; motorCloseTime[i] = oldCloseTimes[i]; }
    saveNetworkConfig();
    server.send(500, "text/html; charset=utf-8",
                "<html><body><h2>Save failed</h2><p>Preferences verification failed. Previous Wi-Fi credentials were retained.</p><a href='/'>Back</a></body></html>");
    return;
  }
  if (!saveMotorTimes()) {
    wifiSsid = oldWifiSsid;
    wifiPassword = oldWifiPassword;
    mqttServer = oldMqttServer;
    mqttPort = oldMqttPort;
    mqttUser = oldMqttUser;
    mqttPass = oldMqttPass;
    haHost = oldHaHost;
    haPort = oldHaPort;
    haCode = oldHaCode;
    for (int i = 0; i < 7; i++) { motorOpenTime[i] = oldOpenTimes[i]; motorCloseTime[i] = oldCloseTimes[i]; }
    saveNetworkConfig();
    saveMotorTimes();
    server.send(500, "text/html; charset=utf-8",
                "<html><body><h2>Save failed</h2><p>Motor timing Preferences verification failed. Previous settings were restored where storage permitted.</p><a href='/'>Back</a></body></html>");
    return;
  }
  setupOTA(); // refresh OTA authentication if the broker password changed
  client.disconnect();
  discoverySent = false;
  if (wifiChanged) wifiChangeRequested = true; // applied from loop(), never restart here

  server.send(200, "text/html; charset=utf-8",
              "<html><head><meta charset='utf-8'></head><body><h2>Configuration saved.</h2><p>"
              + String(wifiChanged ? "Wi-Fi credentials verified and saved. Connecting without restarting; setup portal will return if connection fails." : "Configuration saved. MQTT will reconnect using the new settings.")
              + "</p><a href='/'>Back</a></body></html>");
}

void handleResetWifi() {
  if (!authorizeDashboardRequest()) return;
  server.send(200, "text/html; charset=utf-8",
              "<html><body><h2>Wi-Fi settings will be cleared. Configuration portal will start without restarting the ESP32.</h2></body></html>");
  wifiResetRequested = true;
}

void stopDashboard() {
  if (dashboardStarted) {
    server.stop();
    dashboardStarted = false;
    Serial.println("[HTTP] Dashboard server stopped before Wi-Fi portal/network transition.");
  }
}

void startDashboard() {
  if (dashboardStarted || WiFi.status() != WL_CONNECTED) return;
  if (!dashboardRoutesRegistered) {
    server.on("/", HTTP_GET, handleDashboard);
    server.on("/save", HTTP_POST, handleSave);
    server.on("/resetwifi", HTTP_POST, handleResetWifi);
    dashboardRoutesRegistered = true;
  }
  server.begin();
  dashboardStarted = true;
  Serial.print("Dashboard: http://");
  Serial.println(WiFi.localIP());
}

