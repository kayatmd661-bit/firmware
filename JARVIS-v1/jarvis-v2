// WiFiManager is used only as a non-blocking configuration portal.
void startWiFiPortal();

// ESP32 disconnect events provide the actual 802.11 failure reason; the
// callback only records data and all Serial output is done from loop().
void onWiFiEvent(WiFiEvent_t event, WiFiEventInfo_t info) {
  if (event == ARDUINO_EVENT_WIFI_STA_DISCONNECTED) {
    wifiEventDisconnectReason = info.wifi_sta_disconnected.reason;
    wifiDisconnectEventPending = true;
  } else if (event == ARDUINO_EVENT_WIFI_STA_GOT_IP) {
    wifiGotIpEventPending = true;
  }
}

const char *wifiDisconnectReasonText(uint8_t reason) {
  switch (reason) {
    case 1: return "UNSPECIFIED";
    case 2: return "AUTH_EXPIRE";
    case 3: return "AUTH_LEAVE";
    case 4: return "ASSOC_EXPIRE";
    case 5: return "ASSOC_TOOMANY";
    case 8: return "ASSOC_LEAVE";
    case 15: return "4WAY_HANDSHAKE_TIMEOUT";
    case 23: return "8021X_AUTH_FAILED";
    case 24: return "CIPHER_SUITE_REJECTED";
    case 200: return "BEACON_TIMEOUT";
    case 201: return "NO_AP_FOUND";
    case 202: return "AUTH_FAIL_WRONG_PASSWORD_OR_SECURITY";
    case 203: return "ASSOC_FAIL";
    case 204: return "HANDSHAKE_TIMEOUT";
    case 205: return "CONNECTION_FAIL";
    case 206: return "AP_TSF_RESET";
    case 207: return "ROAMING";
    case 208: return "ASSOC_COMEBACK_TIME_TOO_LONG";
    case 209: return "SA_QUERY_TIMEOUT";
    case 210: return "NO_AP_FOUND_W_COMPATIBLE_SECURITY";
    case 211: return "NO_AP_FOUND_IN_AUTHMODE_THRESHOLD";
    case 212: return "NO_AP_FOUND_IN_RSSI_THRESHOLD";
    default: return "UNKNOWN_WIFI_REASON";
  }
}

const char *wifiStatusText(wl_status_t status) {
  switch (status) {
    case WL_IDLE_STATUS: return "IDLE";
    case WL_NO_SSID_AVAIL: return "NO_SSID_AVAILABLE";
    case WL_SCAN_COMPLETED: return "SCAN_COMPLETED";
    case WL_CONNECTED: return "CONNECTED";
    case WL_CONNECT_FAILED: return "CONNECT_FAILED";
    case WL_CONNECTION_LOST: return "CONNECTION_LOST";
    case WL_DISCONNECTED: return "DISCONNECTED";
    default: return "UNKNOWN_STATUS";
  }
}

// Arduino-ESP32 defaults to WIFI_AUTH_WPA2_PSK as its minimum AP security.
// That silently excludes WPA-PSK-only routers and produces disconnect reason 211.
// Lower only to WPA-PSK: WPA/WPA2 networks are accepted, while OPEN/WEP remain rejected.
void configureWiFiSecurityThreshold() {
  // Arduino-ESP32 3.3.2 declares setMinSecurity() as void.
  // WPA-PSK minimum admits WPA/WPA2 while continuing to reject OPEN/WEP.
  WiFi.setMinSecurity(WIFI_AUTH_WPA_PSK);
  Serial.println("[WiFi SECURITY] Minimum authentication set to WPA-PSK or stronger.");
  Serial.println("[WiFi SECURITY] OPEN and WEP networks remain blocked; WPA/WPA2 networks are eligible.");
}

void beginWiFiAttempt() {
  wifiConnectAttemptCount++;
  wifiDisconnectEventPending = false;
  wifiGotIpEventPending = false;
  wifiRetryScheduled = false;
  wifiConnectStartedAt = millis();
  wifiConnectInProgress = true;
  Serial.printf("[WiFi] Attempt %u/%u for SSID '%s'\n",
                wifiConnectAttemptCount, WIFI_MAX_CONNECT_ATTEMPTS,
                wifiSsid.c_str());
  Serial.printf("[WiFi] Password length: %u (password is not printed)\n",
                (unsigned int)wifiPassword.length());
  configureWiFiSecurityThreshold();
  WiFi.begin(wifiSsid.c_str(), wifiPassword.c_str());
  Serial.println("[WiFi] WiFi.begin() issued asynchronously.");
}

void scheduleWiFiRetry(const char *cause) {
  if (!wifiConnectInProgress || wifiRetryScheduled) return;
  wl_status_t status = WiFi.status();
  Serial.printf("[WiFi ERROR] %s | status=%d (%s) | attempt=%u/%u\n",
                cause, (int)status, wifiStatusText(status),
                wifiConnectAttemptCount, WIFI_MAX_CONNECT_ATTEMPTS);
  if (wifiLastDisconnectReason) {
    Serial.printf("[WiFi ERROR] Disconnect reason=%u (%s)\n",
                  wifiLastDisconnectReason,
                  wifiDisconnectReasonText(wifiLastDisconnectReason));
    if (wifiLastDisconnectReason == 211) {
      Serial.println("[WiFi ROOT CAUSE] AP was excluded by ESP32 minimum auth-mode threshold.");
      Serial.println("[WiFi ROOT CAUSE] Fixed in this build: minimum threshold is WPA-PSK (WPA/WPA2 accepted; OPEN/WEP rejected).");
    } else if (wifiLastDisconnectReason == 210) {
      Serial.println("[WiFi ROOT CAUSE] Router security suite is not compatible with this ESP32 firmware/SDK.");
      Serial.println("[WiFi ACTION] Set router security to WPA2-PSK (AES) or WPA/WPA2 mixed; disable WPA3-only mode.");
    } else if (wifiLastDisconnectReason == 212) {
      Serial.println("[WiFi ROOT CAUSE] AP signal is below the configured RSSI threshold; move ESP32 closer or improve 2.4GHz coverage.");
    }
  } else {
    Serial.println("[WiFi ERROR] No disconnect reason received from driver; checking timeout/status only.");
  }
  if (wifiConnectAttemptCount < WIFI_MAX_CONNECT_ATTEMPTS) {
    wifiRetryScheduled = true;
    wifiRetryAt = millis() + WIFI_RETRY_DELAY_MS;
    Serial.printf("[WiFi] Will retry automatically in %lu ms; saved credentials will be kept.\n",
                  WIFI_RETRY_DELAY_MS);
  } else {
    wifiConnectInProgress = false;
    Serial.println("[WiFi ERROR] All automatic connection attempts failed.");
    Serial.println("[WiFi ERROR] Keeping saved SSID/password; opening setup AP only now.");
    startWiFiPortal();
  }
}
// STA connection attempts are started with WiFi.begin() and checked from loop().
volatile bool wifiManagerConfigSaved = false;

void onWiFiManagerSaveConfig() {
  wifiManagerConfigSaved = true;
}

void buildWiFiManagerParameters() {
  if (wmMqttHost) return;

  String mp = String(mqttPort);
  String hp = String(haPort);

  wmMqttHost = new WiFiManagerParameter("mqtt_host", "MQTT Host / URL", mqttServer.c_str(), 96);
  wmMqttPort = new WiFiManagerParameter("mqtt_port", "MQTT Port", mp.c_str(), 6);
  wmMqttUser = new WiFiManagerParameter("mqtt_user", "MQTT Username", mqttUser.c_str(), 64);
  // Never render the stored MQTT secret into the open setup portal.
  // Leave blank to retain the existing password; a non-empty value replaces it.
  wmMqttPass = new WiFiManagerParameter("mqtt_pass", "MQTT Password (blank keeps current)", "", 64);
  wmHaHost = new WiFiManagerParameter("ha_host", "Home Assistant Host / IP", haHost.c_str(), 96);
  wmHaPort = new WiFiManagerParameter("ha_port", "Home Assistant Port", hp.c_str(), 6);
  wmHaCode = new WiFiManagerParameter("ha_code", "Home Assistant Code / Identifier", haCode.c_str(), 96);

  wifiManager.addParameter(wmMqttHost);
  wifiManager.addParameter(wmMqttPort);
  wifiManager.addParameter(wmMqttUser);
  wifiManager.addParameter(wmMqttPass);
  wifiManager.addParameter(wmHaHost);
  wifiManager.addParameter(wmHaPort);
  wifiManager.addParameter(wmHaCode);

  wifiManager.setConfigPortalBlocking(false);
  // No portal timeout: AP remains available until the user saves settings.
  wifiManager.setSaveConnect(false);       // never block while testing new credentials
  wifiManager.setCaptivePortalEnable(true);  // Enable DNS captive portal so phones can detect and open the setup page
  wifiManager.setShowInfoErase(false);
  wifiManager.setShowInfoUpdate(false);
  wifiManager.setBreakAfterConfig(true);   // return to loop after the form is saved
  wifiManager.setSaveConfigCallback(onWiFiManagerSaveConfig);
  wifiManager.setWiFiAutoReconnect(false);
}

bool saveWiFiManagerValues() {
  // Read the exact SSID/password submitted in the WiFiManager portal.
  String savedSsid = wifiManager.getWiFiSSID(true);
  String savedPassword = wifiManager.getWiFiPass(true);

  if (savedSsid.length() == 0 || savedSsid.length() > 32 || savedPassword.length() > 64) {
    Serial.println("[WiFi SAVE] ERROR: WiFiManager returned an empty SSID; previous Preferences credentials are retained.");
    return false;
  }

  const String oldSsid = wifiSsid;
  const String oldPassword = wifiPassword;
  const String oldMqttServer = mqttServer;
  const uint16_t oldMqttPort = mqttPort;
  const String oldMqttUser = mqttUser;
  const String oldMqttPass = mqttPass;
  const String oldHaHost = haHost;
  const uint16_t oldHaPort = haPort;
  const String oldHaCode = haCode;
  wifiSsid = savedSsid;
  wifiPassword = savedPassword; // Empty password is valid for an open network.

  if (wmMqttHost && String(wmMqttHost->getValue()).length()) mqttServer = wmMqttHost->getValue();
  if (wmMqttPort && String(wmMqttPort->getValue()).length()) parsePort(wmMqttPort->getValue(), mqttPort);
  if (wmMqttUser) mqttUser = wmMqttUser->getValue();
  if (wmMqttPass && String(wmMqttPass->getValue()).length()) mqttPass = wmMqttPass->getValue();
  if (wmHaHost && String(wmHaHost->getValue()).length()) haHost = wmHaHost->getValue();
  if (wmHaPort && String(wmHaPort->getValue()).length()) parsePort(wmHaPort->getValue(), haPort);
  if (wmHaCode) haCode = wmHaCode->getValue();

  if (!saveNetworkConfig()) {
    wifiSsid = oldSsid;
    wifiPassword = oldPassword;
    mqttServer = oldMqttServer;
    mqttPort = oldMqttPort;
    mqttUser = oldMqttUser;
    mqttPass = oldMqttPass;
    haHost = oldHaHost;
    haPort = oldHaPort;
    haCode = oldHaCode;
    saveNetworkConfig();
    Serial.println("[WiFi SAVE] ERROR: Preferences read-back failed; refusing to connect with unverified credentials.");
    return false;
  }

  Serial.println("[WiFi SAVE] SUCCESS: exact SSID/password pair verified in Preferences.");
  Serial.print("[WiFi SAVE] SSID: "); Serial.println(wifiSsid);
  Serial.print("[WiFi SAVE] Password length: "); Serial.println(wifiPassword.length());
  return true;
}

void startWiFiPortal() {
  Serial.println("[WiFi TRACE] Entering startWiFiPortal().");
  Serial.flush();

  // Use our own state flag here. Calling getConfigPortalActive() during the
  // very first startup transition is unnecessary and can enter library code
  // before the application loop begins.
  if (wifiPortalActive) {
    Serial.println("[WiFi TRACE] Portal already marked active; leaving startWiFiPortal().");
    return;
  }

  wifiConnectInProgress = false;
  wifiRetryScheduled = false;
  wifiDisconnectEventPending = false;
  wifiWasConnected = false;
  stopDashboard();
  client.disconnect();
  WiFi.setAutoReconnect(false);
  WiFi.persistent(false);
  WiFi.disconnect(false, true); // erase SDK station profile; Preferences is the only credential source
  WiFi.mode(WIFI_AP_STA);
  wifiManager.setConfigPortalBlocking(false);
  wifiManager.setSaveConnect(false);
  wifiManager.setWiFiAutoReconnect(false);
  wifiManager.setCaptivePortalEnable(true);
  wifiManager.setShowInfoErase(false);
  wifiManager.setShowInfoUpdate(false);
  wifiManager.setBreakAfterConfig(true);
  wifiManager.setSaveConfigCallback(onWiFiManagerSaveConfig);
  char portalPassword[11];
  snprintf(portalPassword, sizeof(portalPassword), "JV%08X", (uint32_t)ESP.getEfuseMac());
  wifiManager.startConfigPortal("Jarvis_Config_AP", portalPassword);
  wifiPortalActive = wifiManager.getConfigPortalActive();

  Serial.println(wifiPortalActive ? "[WiFi] Configuration AP started: Jarvis_Config_AP" : "[WiFi] ERROR: Could not start configuration AP");
  if (wifiPortalActive) Serial.printf("[WiFi] Setup AP password (device-specific): %s\n", portalPassword);
  Serial.print("[WiFi] AP address: ");
  Serial.println(WiFi.softAPIP());
  Serial.println("[WiFi] Phone: connect to Jarvis_Config_AP, choose Stay connected, then open http://192.168.4.1 if the setup page does not pop up.");
}

void startWiFiConnection(const String &ssid, const String &password) {
  Serial.println("[WiFi TRACE] Entering startWiFiConnection().");
  Serial.print("[WiFi TRACE] SSID length: ");
  Serial.println(ssid.length());
  Serial.flush();

  if (ssid.length() == 0) {
    wifiSsid = "";
    wifiPassword = "";
    Serial.println("[WiFi ERROR] Empty SSID; connection cannot start.");
    startWiFiPortal();
    return;
  }

  wifiSsid = ssid;
  wifiPassword = password;
  wifiConnectAttemptCount = 0;
  wifiLastDisconnectReason = 0;
  wifiDisconnectEventPending = false;
  wifiGotIpEventPending = false;
  wifiRetryScheduled = false;
  wifiWasConnected = false;
  stopDashboard();
  client.disconnect();

  if (wifiPortalActive || wifiManager.getConfigPortalActive()) {
    Serial.println("[WiFi TRACE] Stopping active configuration portal before STA connection.");
    wifiManager.stopConfigPortal();
    yield();
    wifiPortalActive = false;
  }

  Serial.println("[WiFi TRACE] Setting station-only mode; using only the verified Preferences credential pair.");
  WiFi.setAutoReconnect(false);
  WiFi.persistent(false);
  WiFi.disconnect(false, true);
  WiFi.mode(WIFI_STA);
  yield();
  beginWiFiAttempt();
}
void serviceWiFi() {
  if (wifiManager.getConfigPortalActive()) {
    wifiPortalActive = true;
    wifiManager.process();
  } else {
    wifiPortalActive = false;
  }

  if (wifiManagerConfigSaved) {
    wifiManagerConfigSaved = false;
    if (saveWiFiManagerValues()) {
      Serial.println("[WiFi] Portal credentials verified; starting asynchronous station connection.");
      startWiFiConnection(wifiSsid, wifiPassword);
    } else {
      Serial.println("[WiFi ERROR] Portal values were not verified. Previous Preferences credentials remain unchanged.");
      startWiFiPortal();
    }
  }

  if (wifiResetRequested) {
    wifiResetRequested = false;
    wifiManager.resetSettings();
    pref.remove("wifi_ssid");
    pref.remove("wifi_pass");
    wifiSsid = "";
    wifiPassword = "";
    wifiWasConnected = false;
    wifiConnectInProgress = false;
    wifiRetryScheduled = false;
    WiFi.setAutoReconnect(false);
    WiFi.persistent(false);
    WiFi.disconnect(false, true);
    startWiFiPortal();
    Serial.println("[WiFi] Credentials erased by explicit reset request. Portal is active.");
  }

  if (wifiChangeRequested) {
    wifiChangeRequested = false;
    startWiFiConnection(requestedWifiSsid, requestedWifiPassword);
  }

  // Process asynchronous ESP32 driver events outside the Wi-Fi callback.
  if (wifiDisconnectEventPending) {
    noInterrupts();
    uint8_t reason = wifiEventDisconnectReason;
    wifiDisconnectEventPending = false;
    interrupts();
    wifiLastDisconnectReason = reason;
    if (wifiConnectInProgress && !wifiPortalActive) {
      Serial.printf("[WiFi EVENT] STA_DISCONNECTED: reason=%u (%s)\n",
                    reason, wifiDisconnectReasonText(reason));
      scheduleWiFiRetry("Station disconnected during connection attempt");
    } else if (wifiWasConnected && !wifiPortalActive) {
      Serial.printf("[WiFi EVENT] Existing Wi-Fi connection lost: reason=%u (%s). Starting recovery.\n",
                    reason, wifiDisconnectReasonText(reason));
      wifiWasConnected = false;
      stopDashboard();
      client.disconnect();
      wifiConnectAttemptCount = 0;
      wifiConnectInProgress = true;
      scheduleWiFiRetry("Runtime Wi-Fi link lost");
    }
  }

  if (wifiGotIpEventPending) {
    wifiGotIpEventPending = false;
    Serial.print("[WiFi EVENT] STA_GOT_IP: ");
    Serial.println(WiFi.localIP());
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiConnectInProgress = false;
    wifiRetryScheduled = false;
    wifiConnectAttemptCount = 0;
    wifiLastDisconnectReason = 0;
    wifiWasConnected = true;

    if (!dashboardStarted) {
      startDashboard();
      setupOTA();
      Serial.println("[WiFi] CONNECTION SUCCESS.");
      Serial.print("[WiFi] SSID: "); Serial.println(WiFi.SSID());
      Serial.print("[WiFi] IP: "); Serial.println(WiFi.localIP());
      Serial.print("[WiFi] RSSI: "); Serial.print(WiFi.RSSI()); Serial.println(" dBm");
    }
  } else if (wifiWasConnected && !wifiPortalActive && !wifiConnectInProgress) {
    // Fallback if a driver disconnect event was missed.
    wifiWasConnected = false;
    stopDashboard();
    client.disconnect();
    wifiConnectAttemptCount = 0;
    wifiConnectInProgress = true;
    scheduleWiFiRetry("Wi-Fi link lost (polling fallback)");
  } else if (wifiConnectInProgress && !wifiPortalActive) {
    wl_status_t status = WiFi.status();
    if (wifiRetryScheduled) {
      if ((long)(millis() - wifiRetryAt) >= 0) {
        Serial.println("[WiFi] Retry timer elapsed; retrying with saved credentials.");
        beginWiFiAttempt();
      }
    } else if (status == WL_CONNECT_FAILED || status == WL_NO_SSID_AVAIL ||
               (millis() - wifiConnectStartedAt >= WIFI_CONNECT_WINDOW_MS)) {
      if (status == WL_NO_SSID_AVAIL) {
        scheduleWiFiRetry("Router SSID not found (NO_SSID_AVAIL)");
      } else if (status == WL_CONNECT_FAILED) {
        scheduleWiFiRetry("Driver reported WL_CONNECT_FAILED");
      } else {
        scheduleWiFiRetry("Connection timeout expired");
      }
    }
  }
}
// ================= OTA ======================================
void setupOTA() {
  if (otaStarted) {
    if (mqttPass.length() >= 8) ArduinoOTA.setPassword(mqttPass.c_str());
    return;
  }
  ArduinoOTA.setHostname("jarvis-home-controller");
  if (mqttPass.length() >= 8) ArduinoOTA.setPassword(mqttPass.c_str());
  ArduinoOTA.onStart([]() {
    otaInProgress = true;
    stopAllMotors();
    Serial.println("OTA Start - all motors stopped; cascade actions suspended.");
  });
  ArduinoOTA.onEnd([]() {
    otaInProgress = false;
    Serial.println("\nOTA End");
  });
  ArduinoOTA.onError([](ota_error_t error) {
    otaInProgress = false;
    Serial.printf("OTA Error[%u]\n", error);
  });
  ArduinoOTA.begin();
  otaStarted = true;
}

// ================= SETUP ====================================
void setup() {
  Serial.begin(115200);
  Serial.println("[HARDWARE CHECK] GPIO0, GPIO2, GPIO5, GPIO12 and GPIO15 are ESP32 boot-strapping pins in this pin map. Verify external switch circuitry cannot force an invalid level during reset.");
  Serial.println("[HARDWARE CHECK] GPIO12 is especially sensitive on classic ESP32 modules; GPIO0 held LOW at power-up enters ROM download mode.");

  // Bring up the I2C expanders first and force every actuator output OFF
  // before loading/restoring any persisted state.
  Wire.begin(I2C_SDA, I2C_SCL);
  pcf1.begin();
  pcf2.begin();
  pcf3.begin();
  pcf4.begin();
  stopAllMotors();
  for (int i = 0; i < 7; i++) pcf3.write(i, LOW);
  pcf4.write(TV_PIN, LOW);
  pcf4.write(SOUND_PIN, LOW);
  pcf4.write(PROJ_PIN, LOW);

  if (!pref.begin("jarvis", false)) {
    Serial.println("[FATAL] Preferences namespace could not be opened. All actuator outputs have been commanded OFF.");
    while (true) { stopAllMotors(); delay(1000); }
  }
  loadNetworkConfig();
  loadMotorTimes();
  if (mqttPass == "12345678") {
    Serial.println("[SECURITY WARNING] Default MQTT/dashboard/OTA password is still active. Change it in the configuration page.");
  } else if (mqttPass.length() < 8) {
    Serial.println("[SECURITY WARNING] MQTT password is shorter than 8 characters; dashboard authentication and OTA password protection will be unavailable.");
  }

  int inputPins[] = {
    LIM_W1_OP, LIM_W1_CL, LIM_W2_OP, LIM_W2_CL,
    LIM_C1_OP, LIM_C1_CL, LIM_C2_OP, LIM_C2_CL,
    L_DOOR_OP, L_DOOR_CL, LIM_C3_OP, LIM_C3_CL,
    LIM_C4_OP, LIM_C4_CL, LOCK_BUTTON, BOOT_BUTTON
  };
  for (size_t i = 0; i < sizeof(inputPins) / sizeof(inputPins[0]); i++)
    pinMode(inputPins[i], INPUT_PULLUP);
  pinMode(ACCESS_CONTROL_PIN, INPUT);

  recoverStates();

  client.setCallback(callback);
  client.setSocketTimeout(1);
  client.setBufferSize(1024);
  client.setServer(mqttServer.c_str(), mqttPort);

  buildWiFiManagerParameters();
  WiFi.onEvent(onWiFiEvent);
  Serial.println("[WiFi] ESP32 Wi-Fi event diagnostics registered.");
  WiFi.persistent(false);
  WiFi.setAutoReconnect(false);
  WiFi.mode(WIFI_STA);
  configureWiFiSecurityThreshold();
  wifiManager.setWiFiAutoReconnect(false);

  // Preferences is the single source of truth. Never restore an older
  // WiFiManager/SDK credential pair after the user has replaced credentials.

  Serial.println("[WiFi] Starting non-blocking startup sequence.");
  Serial.print("[WiFi TRACE] Loaded SSID length: ");
  Serial.println(wifiSsid.length());
  Serial.flush();
  if (wifiSsid.length() > 0) {
    startWiFiConnection(wifiSsid, wifiPassword);
  } else {
    startWiFiPortal();
  }

  Serial.println("JARVIS Home Controller main loop started.");
}

// ================= RUNTIME ==================================
void processResetButton() {
  bool pressed = (digitalRead(LOCK_BUTTON) == LOW || digitalRead(BOOT_BUTTON) == LOW);

  if (pressed) {
    if (!isResetButtonPressed) {
      resetStartTime = millis();
      isResetButtonPressed = true;
      resetLongPressHandled = false;
    }
    if (!resetLongPressHandled && millis() - resetStartTime >= 10000UL) {
      Serial.println("[WiFi] Long press detected: request Wi-Fi credential reset.");
      wifiResetRequested = true;
      resetLongPressHandled = true; // one reset per press; release is required to arm again
    }
  } else {
    isResetButtonPressed = false;
    resetLongPressHandled = false;
  }
}

void processMotors() {
  handleMotor(win1, digitalRead(LIM_W1_OP) == LOW, digitalRead(LIM_W1_CL) == LOW,
              0, "win1");

  handleMotor(win2, digitalRead(LIM_W2_OP) == LOW, digitalRead(LIM_W2_CL) == LOW,
              1, "win2");

  handleMotor(cur1, digitalRead(LIM_C1_OP) == LOW, digitalRead(LIM_C1_CL) == LOW,
              2, "cur1");

  handleMotor(cur2, digitalRead(LIM_C2_OP) == LOW, digitalRead(LIM_C2_CL) == LOW,
              3, "cur2");

  handleMotor(door, digitalRead(L_DOOR_OP) == LOW, digitalRead(L_DOOR_CL) == LOW,
              4, "door");

  handleMotor(cur3, digitalRead(LIM_C3_OP) == LOW, digitalRead(LIM_C3_CL) == LOW,
              5, "cur3");

  handleMotor(cur4, digitalRead(LIM_C4_OP) == LOW, digitalRead(LIM_C4_CL) == LOW,
              6, "cur4");
}

void processCascade() {
  bool cur3OpenHit, cur3CloseHit, cur4OpenHit, cur4CloseHit;
  getLimitsForIndex(5, cur3OpenHit, cur3CloseHit);
  getLimitsForIndex(6, cur4OpenHit, cur4CloseHit);

  // Cascades are triggered only by a confirmed target end-stop event,
  // never by STOP commands, timeouts, opposite-limit faults, or OTA stops.
  if (otaInProgress) return;

  if (motorLimitCompletion[5] && cur3 == STOPPED && cur3OpenHit && !cur3CloseHit) {
    motorLimitCompletion[5] = false;
    Serial.println("Cascade: Curtain 3 reached OPEN limit -> Opening Curtain 4");
    startMotorCommand("cur4", true);
  }
  if (motorLimitCompletion[6] && cur4 == STOPPED && cur4OpenHit && !cur4CloseHit) {
    motorLimitCompletion[6] = false;
    Serial.println("Cascade: Curtain 4 reached OPEN limit -> Turning ON Projector");
    setAVHardware("proj", true);
  }
  if (motorLimitCompletion[6] && cur4 == STOPPED && cur4CloseHit && !cur4OpenHit) {
    motorLimitCompletion[6] = false;
    Serial.println("Cascade: Curtain 4 reached CLOSE limit -> Closing Curtain 3");
    startMotorCommand("cur3", false);
  }
}

void loop() {
  serviceWiFi();
  yield();

  bool wifiConnected = (WiFi.status() == WL_CONNECTED);
  if (wifiConnected) {
    if (!client.connected()) {
      unsigned long now = millis();
      if (now - lastReconnectAttempt >= 5000UL) {
        lastReconnectAttempt = now;
        if (tryReconnect()) lastReconnectAttempt = 0;
      }
    } else {
      client.loop();
      if (clearRetainedPositionsOnFirstConnect &&
          millis() - lastPositionClearAttempt >= 5000UL) {
        clearRetainedCoverPositions();
      }
      if (!discoverySent && millis() - lastDiscoveryAttempt >= 30000UL) {
        Serial.println("[MQTT] Retrying incomplete Home Assistant discovery publish set.");
        setupAutoDiscovery();
      }
    }
  }

  if (dashboardStarted) server.handleClient();
  if (wifiConnected) ArduinoOTA.handle();
  yield();

  processResetButton();
  processMotors();
  processCascade();

  // Yield to Wi-Fi/TCP/IP tasks without a blocking delay or application WDT.
  yield();
}

