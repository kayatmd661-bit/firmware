void reportStatus(const String &uid, bool state) {
  if (!client.connected()) return;
  String topic = String(mqttBase) + "/status/" + uid;
  String payload = state ? "ON" : "OFF";
  client.publish(topic.c_str(), payload.c_str(), true);
}

void reportCoverStatus(const String &uid, MotorAction state) {
  if (!client.connected()) return;
  String topic = String(mqttBase) + "/status/" + uid;
  String payload = motorText(state);
  client.publish(topic.c_str(), payload.c_str(), true);
}

int motorIndexForUid(const String &uid) {
  if (uid == "win1") return 0;
  if (uid == "win2") return 1;
  if (uid == "cur1") return 2;
  if (uid == "cur2") return 3;
  if (uid == "door") return 4;
  if (uid == "cur3") return 5;
  if (uid == "cur4") return 6;
  return -1;
}

void reportCoverPosition(const String &uid, int position) {
  if (!client.connected() || position < 0) return;
  if (position > 100) position = 100;
  int idx = motorIndexForUid(uid);
  if (idx < 0) return;
  unsigned long now = millis();
  // Avoid flooding MQTT with a position update on every loop pass.
  if (now - lastPositionPublish[idx] < 1000UL && position != 0 && position != 100) return;
  lastPositionPublish[idx] = now;
  String topic = String(mqttBase) + "/status/" + uid + "/position";
  String payload = String(position);
  client.publish(topic.c_str(), payload.c_str(), true);
}

String discoveryPayload(const char *component, const char *name, const char *uid) {
  // Build a standards-compliant Home Assistant MQTT Discovery payload.
  // Keep the existing topics, UIDs, device grouping and hardware command
  // protocol unchanged; only the discovery metadata is corrected.
  String statusTopic = String(mqttBase) + "/status/" + uid;
  String cmdTopic = String(mqttBase) + "/" + uid + "/cmd";

  String p = "{";
  p += "\"name\":\"" + String(name) + "\",";
  p += "\"unique_id\":\"jarvis_" + String(uid) + "\",";
  p += "\"availability_topic\":\"" + String(availTopic) + "\",";
  p += "\"payload_available\":\"online\",";
  p += "\"payload_not_available\":\"offline\",";
  p += "\"state_topic\":\"" + statusTopic + "\",";
  p += "\"command_topic\":\"" + cmdTopic + "\",";

  if (strcmp(component, "light") == 0) {
    // On/off only. The previous schema=template declaration was invalid
    // without command_on_template/command_off_template and could cause HA
    // to reject the discovery config.
    p += "\"payload_on\":\"ON\",\"payload_off\":\"OFF\",";
  } else if (strcmp(component, "cover") == 0) {
    p += "\"payload_open\":\"OPEN\",\"payload_close\":\"CLOSE\",\"payload_stop\":\"STOP\",";
    p += "\"state_opening\":\"OPENING\",\"state_closing\":\"CLOSING\",\"state_stopped\":\"STOPPED\",";
    p += "\"position_topic\":\"" + statusTopic + "/position\",";
  } else {
    p += "\"payload_on\":\"ON\",\"payload_off\":\"OFF\",";
  }

  p += "\"device\":{";
  p += "\"identifiers\":[\"" + String(haDeviceId) + "\"],";
  p += "\"name\":\"" + String(haDeviceName) + "\",";
  p += "\"manufacturer\":\"Liton Tech\",";
  p += "\"model\":\"ESP32-PCF8574 Home Controller\",";
  p += "\"sw_version\":\"Final-Configurable-1.0\"}";
  p += "}";
  return p;
}

bool sendDiscovery(const char *component, const char *name, const char *uid) {
  if (!client.connected()) return false;
  String topic = "homeassistant/" + String(component) + "/jarvis_final/" + uid + "/config";
  String payload = discoveryPayload(component, name, uid);
  bool published = client.publish(topic.c_str(), payload.c_str(), true);

  // Diagnostic only: no hardware or control logic is changed.
  Serial.print("MQTT Discovery ");
  Serial.print(component);
  Serial.print("/");
  Serial.print(uid);
  Serial.print(" -> ");
  Serial.print(published ? "OK" : "FAILED");
  Serial.print(" (bytes=");
  Serial.print(payload.length());
  Serial.println(")");
  return published;
}

void setupAutoDiscovery() {
  if (discoverySent || !client.connected()) return;
  bool allPublished = true;
  for (int i = 0; i < 7; i++) {
    String uid = "l" + String(i + 1);
    String name = "লাইট " + String(i + 1);
    if (!sendDiscovery("light", name.c_str(), uid.c_str())) allPublished = false;
  }
  if (!sendDiscovery("switch", "টিভি", "tv")) allPublished = false;
  if (!sendDiscovery("switch", "সাউন্ড", "sound")) allPublished = false;
  if (!sendDiscovery("switch", "প্রজেক্টর", "proj")) allPublished = false;
  if (!sendDiscovery("cover", "দরজা", "door")) allPublished = false;
  if (!sendDiscovery("cover", "জানালা ১", "win1")) allPublished = false;
  if (!sendDiscovery("cover", "জানালা ২", "win2")) allPublished = false;
  if (!sendDiscovery("cover", "পর্দা ১", "cur1")) allPublished = false;
  if (!sendDiscovery("cover", "পর্দা ২", "cur2")) allPublished = false;
  if (!sendDiscovery("cover", "পর্দা ৩", "cur3")) allPublished = false;
  if (!sendDiscovery("cover", "পর্দা ৪", "cur4")) allPublished = false;
  discoverySent = allPublished;
  lastDiscoveryAttempt = millis();
}

void clearRetainedCoverPositions() {
  if (!client.connected() || !clearRetainedPositionsOnFirstConnect) return;
  const char *uids[7] = {"win1", "win2", "cur1", "cur2", "door", "cur3", "cur4"};
  bool allCleared = true;
  for (int i = 0; i < 7; i++) {
    String topic = String(mqttBase) + "/status/" + uids[i] + "/position";
    // Position is deliberately unknown after a reboot because motors are never resumed.
    if (!client.publish(topic.c_str(), "", true)) allCleared = false;
  }
  lastPositionClearAttempt = millis();
  if (allCleared) clearRetainedPositionsOnFirstConnect = false;
}

void syncAllStates() {
  for (int i = 0; i < 7; i++)
    reportStatus("l" + String(i + 1), lightState[i]);

  reportStatus("tv", tvState);
  reportStatus("sound", soundState);
  reportStatus("proj", projectorState);

  reportCoverStatus("door", door);
  reportCoverStatus("win1", win1);
  reportCoverStatus("win2", win2);
  reportCoverStatus("cur1", cur1);
  reportCoverStatus("cur2", cur2);
  reportCoverStatus("cur3", cur3);
  reportCoverStatus("cur4", cur4);
}

bool tryReconnect() {
  if (client.connected()) return true;

  client.setServer(mqttServer.c_str(), mqttPort);
  client.setSocketTimeout(1);

  String clientId = "Jarvis_Home_Controller-" +
                    String((uint32_t)ESP.getEfuseMac(), HEX);

  bool ok;
  if (mqttUser.length()) {
    ok = client.connect(clientId.c_str(), mqttUser.c_str(), mqttPass.c_str(),
                        availTopic, 1, true, "offline");
  } else {
    ok = client.connect(clientId.c_str(), availTopic, 1, true, "offline");
  }

  if (!ok) return false;

  client.publish(availTopic, "online", true);
  client.subscribe("jarvis/+/cmd");
  clearRetainedCoverPositions();
  setupAutoDiscovery();
  syncAllStates();

  Serial.println("MQTT Connected!");
  return true;
}

// ================= HARDWARE =================================
void setLightHardware(int index, bool state) {
  const int pins[7] = {L1_PIN,L2_PIN,L3_PIN,L4_PIN,L5_PIN,L6_PIN,L7_PIN};
  pcf3.write(pins[index], state ? HIGH : LOW);
  lightState[index] = state;
  pref.putBool(("l" + String(index + 1)).c_str(), state);
  reportStatus("l" + String(index + 1), state);
}

void setAVHardware(const String &uid, bool state) {
  if (uid == "tv") {
    pcf4.write(TV_PIN, state ? HIGH : LOW);
    tvState = state;
    pref.putBool("tv", state);
    reportStatus("tv", state);
  } else if (uid == "sound") {
    pcf4.write(SOUND_PIN, state ? HIGH : LOW);
    soundState = state;
    pref.putBool("sound", state);
    reportStatus("sound", state);
  } else if (uid == "proj") {
    pcf4.write(PROJ_PIN, state ? HIGH : LOW);
    projectorState = state;
    pref.putBool("proj", state);
    reportStatus("proj", state);

    // Existing cascade preserved: Projector OFF -> Curtain 4 CLOSE.
    if (!state) {
      Serial.println("Cascade: Projector OFF -> Closing Curtain 4");
      startMotorCommand("cur4", false);
    }
  }
}

bool getLimitsForIndex(int idx, bool &openHit, bool &closeHit) {
  openHit = closeHit = false;
  switch (idx) {
    case 0: openHit = digitalRead(LIM_W1_OP) == LOW; closeHit = digitalRead(LIM_W1_CL) == LOW; break;
    case 1: openHit = digitalRead(LIM_W2_OP) == LOW; closeHit = digitalRead(LIM_W2_CL) == LOW; break;
    case 2: openHit = digitalRead(LIM_C1_OP) == LOW; closeHit = digitalRead(LIM_C1_CL) == LOW; break;
    case 3: openHit = digitalRead(LIM_C2_OP) == LOW; closeHit = digitalRead(LIM_C2_CL) == LOW; break;
    case 4: openHit = digitalRead(L_DOOR_OP) == LOW; closeHit = digitalRead(L_DOOR_CL) == LOW; break;
    case 5: openHit = digitalRead(LIM_C3_OP) == LOW; closeHit = digitalRead(LIM_C3_CL) == LOW; break;
    case 6: openHit = digitalRead(LIM_C4_OP) == LOW; closeHit = digitalRead(LIM_C4_CL) == LOW; break;
    default: return false;
  }
  return true;
}

MotorAction *getMotorState(const String &uid, int &idx) {
  idx = -1;
  if (uid == "win1") { idx = 0; return &win1; }
  if (uid == "win2") { idx = 1; return &win2; }
  if (uid == "cur1") { idx = 2; return &cur1; }
  if (uid == "cur2") { idx = 3; return &cur2; }
  if (uid == "door") { idx = 4; return &door; }
  if (uid == "cur3") { idx = 5; return &cur3; }
  if (uid == "cur4") { idx = 6; return &cur4; }
  return nullptr;
}

int estimateMotorPosition(int idx, MotorAction action, unsigned long elapsed, unsigned long timeout) {
  if (idx < 0 || idx >= 7 || motorPositionStart[idx] < 0 || timeout == 0) return -1;
  unsigned long progress = min(100UL, (elapsed * 100UL) / timeout);
  int start = motorPositionStart[idx];
  if (action == OPENING) return start + ((100 - start) * (int)progress) / 100;
  if (action == CLOSING) return start - (start * (int)progress) / 100;
  return start;
}

void refreshMotorPosition(int idx, MotorAction action, unsigned long elapsed,
                          unsigned long timeout, bool publishUpdate) {
  int position = estimateMotorPosition(idx, action, elapsed, timeout);
  if (position < 0) return; // Position is unknown until an end-stop is confirmed.
  if (position > 100) position = 100;
  if (position < 0) position = 0;
  if (position != motorPosition[idx]) {
    motorPosition[idx] = (int8_t)position;
    if (publishUpdate && millis() - motorLastPositionUpdate[idx] >= 1000UL) {
      reportCoverPosition(idx == 0 ? "win1" : idx == 1 ? "win2" : idx == 2 ? "cur1" :
                          idx == 3 ? "cur2" : idx == 4 ? "door" : idx == 5 ? "cur3" : "cur4", position);
      motorLastPositionUpdate[idx] = millis();
    }
  }
}

void writeMotorOutputs(int idx, bool directionA, bool directionB) {
  if (idx < 0 || idx >= 7) return;
  // Never energize both H-bridge directions at once.
  if (directionA && directionB) directionA = directionB = false;
  if (motorOutputKnown[idx] && motorOutputA[idx] == directionA &&
      motorOutputB[idx] == directionB) return;

  PCF8574 *pcf = (idx <= 3) ? &pcf1 : &pcf2;
  int pinA = -1, pinB = -1;
  switch (idx) {
    case 0: pinA = PIN_M_WIN1_A; pinB = PIN_M_WIN1_B; break;
    case 1: pinA = PIN_M_WIN2_A; pinB = PIN_M_WIN2_B; break;
    case 2: pinA = PIN_M_CUR1_A; pinB = PIN_M_CUR1_B; break;
    case 3: pinA = PIN_M_CUR2_A; pinB = PIN_M_CUR2_B; break;
    case 4: pinA = PIN_M_DOOR_A; pinB = PIN_M_DOOR_B; break;
    case 5: pinA = PIN_M_CUR3_A; pinB = PIN_M_CUR3_B; break;
    case 6: pinA = PIN_M_CUR4_A; pinB = PIN_M_CUR4_B; break;
  }
  if (pinA < 0 || pinB < 0) return;

  // De-energize both outputs before applying a new direction.
  if ((motorOutputA[idx] && directionB) || (motorOutputB[idx] && directionA)) {
    pcf->write(pinA, LOW);
    pcf->write(pinB, LOW);
    motorOutputA[idx] = false;
    motorOutputB[idx] = false;
    motorOutputKnown[idx] = true;
  }
  pcf->write(pinA, directionA ? HIGH : LOW);
  pcf->write(pinB, directionB ? HIGH : LOW);
  motorOutputA[idx] = directionA;
  motorOutputB[idx] = directionB;
  motorOutputKnown[idx] = true;
}

void startMotorCommand(const String &uid, bool open) {
  int idx;
  MotorAction *state = getMotorState(uid, idx);
  if (!state) return;

  bool openHit, closeHit;
  if (!getLimitsForIndex(idx, openHit, closeHit)) return;
  motorLimitCompletion[idx] = false;

  if (openHit && closeHit) {
    writeMotorOutputs(idx, false, false);
    *state = STOPPED;
    motorTimingStarted[idx] = false;
    motorPosition[idx] = -1;
    motorPositionStart[idx] = -1;
    motorLimitFault[idx] = true;
    Serial.print("[MOTOR SAFETY] Both limit switches active; refusing command: ");
    Serial.println(uid);
    reportCoverStatus(uid, STOPPED);
    return;
  }

  if (*state != STOPPED && motorTimingStarted[idx]) {
    unsigned long previousTimeout = (*state == OPENING) ? motorOpenTime[idx] : motorCloseTime[idx];
    refreshMotorPosition(idx, *state, millis() - motorStartTime[idx], previousTimeout, false);
  }
  if (openHit) motorPosition[idx] = 100;
  else if (closeHit) motorPosition[idx] = 0;

  if ((open && openHit) || (!open && closeHit)) {
    writeMotorOutputs(idx, false, false);
    *state = STOPPED;
    motorTimingStarted[idx] = false;
    motorPositionStart[idx] = motorPosition[idx];
    reportCoverStatus(uid, STOPPED);
    reportCoverPosition(uid, open ? 100 : 0);
    return;
  }

  // Break-before-make: force both directions OFF before any start/reversal.
  writeMotorOutputs(idx, false, false);
  motorTimingStarted[idx] = false;
  motorDeadtimeUntil[idx] = millis() + 150UL;
  motorPositionStart[idx] = motorPosition[idx];
  *state = open ? OPENING : CLOSING;
  reportCoverStatus(uid, *state);
}

void handleMotor(MotorAction &state, bool opHit, bool clHit,
                 int idx, const String &uid) {
  if (opHit && clHit) {
    writeMotorOutputs(idx, false, false);
    if (!motorLimitFault[idx]) {
      Serial.print("[MOTOR SAFETY] Both limit switches active; motor stopped: ");
      Serial.println(uid);
      reportCoverStatus(uid, STOPPED);
    }
    state = STOPPED;
    motorTimingStarted[idx] = false;
    motorPosition[idx] = -1;
    motorPositionStart[idx] = -1;
    motorLimitCompletion[idx] = false;
    motorLimitFault[idx] = true;
    return;
  }
  motorLimitFault[idx] = false;

  if (state == STOPPED) {
    writeMotorOutputs(idx, false, false);
    motorTimingStarted[idx] = false;
    return;
  }

  // Allow a short dead-time after every start or reversal.
  if (!motorTimingStarted[idx]) {
    if ((int32_t)(millis() - motorDeadtimeUntil[idx]) < 0) {
      writeMotorOutputs(idx, false, false);
      return;
    }
    motorStartTime[idx] = millis();
    motorTimingStarted[idx] = true;
  }

  unsigned long elapsed = millis() - motorStartTime[idx];
  unsigned long timeout = (state == OPENING) ? motorOpenTime[idx] : motorCloseTime[idx];
  bool limitReached = (state == OPENING) ? opHit : clHit;
  bool oppositeLimitHit = (state == OPENING) ? clHit : opHit;

  refreshMotorPosition(idx, state, elapsed, timeout, true);

  if (limitReached || oppositeLimitHit || elapsed >= timeout) {
    const MotorAction completedDirection = state;
    writeMotorOutputs(idx, false, false);
    state = STOPPED;
    motorTimingStarted[idx] = false;
    reportCoverStatus(uid, STOPPED);
    if (limitReached) {
      motorPosition[idx] = completedDirection == OPENING ? 100 : 0;
      motorPositionStart[idx] = motorPosition[idx];
      motorLimitCompletion[idx] = true;
      reportCoverPosition(uid, motorPosition[idx]);
    } else if (oppositeLimitHit) {
      motorLimitCompletion[idx] = false;
      Serial.print("[MOTOR SAFETY] Unexpected opposite limit switch; stopped: ");
      Serial.println(uid);
    } else {
      motorLimitCompletion[idx] = false;
      Serial.print("[MOTOR TIMEOUT] "); Serial.println(uid);
    }
    return;
  }

  writeMotorOutputs(idx, state == OPENING, state == CLOSING);

  // Position was updated above from the last confirmed endpoint / last estimate.
  // After a reboot it remains unknown until a real limit switch is reached.
}

void stopMotorById(const String &uid) {
  int idx;
  MotorAction *state = getMotorState(uid, idx);
  if (!state) return;
  if (*state != STOPPED && motorTimingStarted[idx]) {
    unsigned long timeout = (*state == OPENING) ? motorOpenTime[idx] : motorCloseTime[idx];
    refreshMotorPosition(idx, *state, millis() - motorStartTime[idx], timeout, false);
    motorPositionStart[idx] = motorPosition[idx];
  }
  writeMotorOutputs(idx, false, false);
  *state = STOPPED;
  motorTimingStarted[idx] = false;
  motorLimitCompletion[idx] = false;
  reportCoverStatus(uid, STOPPED);
}

void stopAllMotors() {
  for (int i = 0; i < 7; i++) {
    MotorAction *state = nullptr;
    switch (i) {
      case 0: state = &win1; break;
      case 1: state = &win2; break;
      case 2: state = &cur1; break;
      case 3: state = &cur2; break;
      case 4: state = &door; break;
      case 5: state = &cur3; break;
      case 6: state = &cur4; break;
    }
    if (state && *state != STOPPED && motorTimingStarted[i]) {
      unsigned long timeout = (*state == OPENING) ? motorOpenTime[i] : motorCloseTime[i];
      refreshMotorPosition(i, *state, millis() - motorStartTime[i], timeout, false);
      motorPositionStart[i] = motorPosition[i];
    }
    writeMotorOutputs(i, false, false);
    motorTimingStarted[i] = false;
    motorLimitCompletion[i] = false;
  }
  win1 = win2 = cur1 = cur2 = cur3 = cur4 = door = STOPPED;
  reportCoverStatus("win1", STOPPED);
  reportCoverStatus("win2", STOPPED);
  reportCoverStatus("cur1", STOPPED);
  reportCoverStatus("cur2", STOPPED);
  reportCoverStatus("door", STOPPED);
  reportCoverStatus("cur3", STOPPED);
  reportCoverStatus("cur4", STOPPED);
}

// ================= COMMAND ROUTING ==========================
void executeHardwareByID(String uid, String cmd) {
  uid.trim();
  cmd.trim();
  cmd.toUpperCase();

  if (cmd == "STOP") {
    stopMotorById(uid);
    return;
  }
  if (cmd != "ON" && cmd != "OFF" && cmd != "OPEN" && cmd != "CLOSE") {
    Serial.print("[MQTT] Ignored invalid command: "); Serial.println(cmd);
    return;
  }

  bool state = (cmd == "ON" || cmd == "OPEN");

  Serial.println("--- Hardware Execute ---");
  Serial.print("Device UID: "); Serial.println(uid);
  Serial.print("Command: "); Serial.println(cmd);

  if (uid == "l1") setLightHardware(0, state);
  else if (uid == "l2") setLightHardware(1, state);
  else if (uid == "l3") setLightHardware(2, state);
  else if (uid == "l4") setLightHardware(3, state);
  else if (uid == "l5") setLightHardware(4, state);
  else if (uid == "l6") setLightHardware(5, state);
  else if (uid == "l7") setLightHardware(6, state);
  else if (uid == "tv" || uid == "sound" || uid == "proj") setAVHardware(uid, state);
  else if (uid == "win1" || uid == "win2" || uid == "cur1" ||
           uid == "cur2" || uid == "door" || uid == "cur3" || uid == "cur4")
    startMotorCommand(uid, state);
}

// ================= STATE RECOVERY ===========================
void recoverStates() {
  for (int i = 0; i < 7; i++) {
    lightState[i] = pref.getBool(("l" + String(i + 1)).c_str(), false);
    const int pins[7] = {L1_PIN,L2_PIN,L3_PIN,L4_PIN,L5_PIN,L6_PIN,L7_PIN};
    pcf3.write(pins[i], lightState[i] ? HIGH : LOW);
  }

  tvState = pref.getBool("tv", false);
  soundState = pref.getBool("sound", false);
  projectorState = pref.getBool("proj", false);

  pcf4.write(TV_PIN, tvState ? HIGH : LOW);
  pcf4.write(SOUND_PIN, soundState ? HIGH : LOW);
  pcf4.write(PROJ_PIN, projectorState ? HIGH : LOW);

  // Never restore a moving motor after reboot.
  stopAllMotors();
}

// ================= MQTT CALLBACK ============================
void callback(char *topic, byte *payload, unsigned int length) {
  String message;
  message.reserve(length + 1);
  for (unsigned int i = 0; i < length; i++) message += (char)payload[i];

  String topicStr = String(topic);
  int first = topicStr.indexOf('/');
  int second = topicStr.indexOf('/', first + 1);
  if (first < 0 || second < 0) return;

  String uid = topicStr.substring(first + 1, second);
  uid.trim();

  executeHardwareByID(uid, message);
}

